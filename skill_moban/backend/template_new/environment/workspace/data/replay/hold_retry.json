{
  "name": "hold_retry",
  "description": "Safe client retry with the same idempotency key should not block stock twice.",
  "steps": [
    {
      "method": "POST",
      "path": "/api/v1/holds",
      "headers": {
        "Idempotency-Key": "replay-hold-retry-1"
      },
      "json": {
        "sku": "CHAIR-RED-001",
        "location": "store-nyc",
        "quantity": 2,
        "hold_seconds": 6,
        "customer_id": "cust-replay-a"
      }
    },
    {
      "sleep_seconds": 0.2
    },
    {
      "method": "POST",
      "path": "/api/v1/holds",
      "headers": {
        "Idempotency-Key": "replay-hold-retry-1"
      },
      "json": {
        "sku": "CHAIR-RED-001",
        "location": "store-nyc",
        "quantity": 2,
        "hold_seconds": 6,
        "customer_id": "cust-replay-a"
      }
    }
  ]
}
