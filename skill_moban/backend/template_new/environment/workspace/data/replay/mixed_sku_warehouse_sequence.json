{
  "name": "mixed_sku_warehouse_sequence",
  "description": "Operations on one sku-location pair must not bleed into others.",
  "steps": [
    {
      "method": "POST",
      "path": "/api/v1/holds",
      "headers": {
        "Idempotency-Key": "mixed-nyc-chair"
      },
      "json": {
        "sku": "CHAIR-RED-001",
        "location": "store-nyc",
        "quantity": 2,
        "hold_seconds": 8,
        "customer_id": "cust-mixed-1"
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/holds",
      "headers": {
        "Idempotency-Key": "mixed-sf-chair"
      },
      "json": {
        "sku": "CHAIR-RED-001",
        "location": "store-sf",
        "quantity": 1,
        "hold_seconds": 8,
        "customer_id": "cust-mixed-2"
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/holds",
      "headers": {
        "Idempotency-Key": "mixed-nyc-lamp"
      },
      "json": {
        "sku": "LAMP-BLUE-002",
        "location": "store-nyc",
        "quantity": 3,
        "hold_seconds": 8,
        "customer_id": "cust-mixed-3"
      }
    }
  ]
}
