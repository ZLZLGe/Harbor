<section
  class="predictive-search-preview"
  data-predictive-search
  data-query="{{ query }}"
>
  <header>
    <p class="eyebrow">Predictive Search</p>
    <h1>Search suggestions for "{{ query }}"</h1>
  </header>

  {% for group in groups %}
    <section
      class="predictive-group"
      data-predictive-group="{{ group.id }}"
    >
      <h2>{{ group.label }}</h2>
      <ul>
        {% for item in group.items %}
          <li data-predictive-item>
            {% if group.id == 'products' %}
              <span data-search-product-handle="{{ item.handle }}">
                {{ item.title }}
                {% if section.settings.show_product_prices %}
                  · {{ item.price | money }}
                {% endif %}
              </span>
            {% elsif group.id == 'collections' %}
              <span data-search-collection-handle="{{ item.handle }}">
                {{ item.title }}
              </span>
            {% else %}
              <span data-search-query>{{ item.text }}</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
</section>
