<section
  class="collection-surface"
  data-collection-handle="{{ collection.handle }}"
>
  <header class="collection-header">
    <p class="eyebrow">Collection Preview</p>
    <h1>{{ collection.title }}</h1>
    <p>{{ collection.description }}</p>
  </header>

  <div class="collection-controls">
    <div class="filters-panel">
      {% for filter in filters %}
        <section
          class="filter-group"
          data-filter-group
          data-filter-id="{{ filter.id }}"
        >
          <h2>{{ filter.label }}</h2>
          <ul>
            {% for option in filter.options %}
              <li
                data-filter-option
                data-filter-value="{{ option.value }}"
              >
                <span class="filter-label">{{ option.value }}</span>
                <span class="filter-count">{{ option.count }}</span>
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endfor %}
    </div>

    <div
      class="sort-panel"
      data-sort-control
      data-selected-sort="{{ selected_sort }}"
    >
      <h2>Sort</h2>
      <ul>
        {% for sort_option in sort_options %}
          <li
            data-sort-option
            data-sort-value="{{ sort_option.value }}"
          >
            {{ sort_option.label }}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="product-grid" data-product-grid>
    {% for product in products %}
      {% render 'product-card', product: product, section: section %}
    {% endfor %}
  </div>
</section>
