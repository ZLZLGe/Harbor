{
  "name": "rollout-summary-api",
  "location": "eastus2",
  "properties": {
    "identity": {
      "type": "UserAssigned",
      "clientId": "rollout-reader-client"
    },
    "configuration": {
      "ingress": {
        "external": true,
        "targetPort": 9200
      },
      "secrets": [
        {
          "name": "incident-feed-base-url",
          "value": "http://127.0.0.1:8320"
        },
        {
          "name": "mirror-scope",
          "value": "api://rollout-mirror/.default"
        }
      ]
    },
    "template": {
      "containers": [
        {
          "name": "rollout-summary-api",
          "image": "local/rollout-summary-api:dev",
          "env": [
            {
              "name": "PORT",
              "value": "9200"
            },
            {
              "name": "INCIDENT_FEED_BASE_URL",
              "secretRef": "incident-feed-base-url"
            },
            {
              "name": "MIRROR_SCOPE",
              "secretRef": "mirror-scope"
            },
            {
              "name": "MANAGED_IDENTITY_CLIENT_ID",
              "value": "rollout-reader-client"
            }
          ]
        }
      ],
      "probes": {
        "readiness": {
          "path": "/healthz",
          "port": 9200
        }
      }
    }
  }
}
