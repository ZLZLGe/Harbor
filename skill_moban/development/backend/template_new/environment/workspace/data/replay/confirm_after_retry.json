{
  "name": "confirm_after_retry",
  "description": "Confirming a hold after a safe retry should commit inventory exactly once.",
  "steps": [
    {
      "method": "POST",
      "path": "/api/v1/holds",
      "headers": {
        "Idempotency-Key": "replay-confirm-retry-1"
      },
      "json": {
        "sku": "DESK-OAK-003",
        "location": "store-nyc",
        "quantity": 1,
        "hold_seconds": 5,
        "customer_id": "cust-replay-c"
      }
    },
    {
      "sleep_seconds": 0.2
    },
    {
      "method": "POST",
      "path": "/api/v1/holds",
      "headers": {
        "Idempotency-Key": "replay-confirm-retry-1"
      },
      "json": {
        "sku": "DESK-OAK-003",
        "location": "store-nyc",
        "quantity": 1,
        "hold_seconds": 5,
        "customer_id": "cust-replay-c"
      }
    }
  ]
}
