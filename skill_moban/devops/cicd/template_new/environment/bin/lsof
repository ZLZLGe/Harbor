#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path

trace = Path(os.environ.get("APP_ROOT", "/app")) / ".trace"
trace.mkdir(parents=True, exist_ok=True)
with (trace / "commands.jsonl").open("a", encoding="utf-8") as f:
    f.write(json.dumps({"kind": "lsof", "argv": sys.argv[1:], "cmd": "lsof " + " ".join(sys.argv[1:]), "return_code": 1}, sort_keys=True) + "\n")
sys.exit(1)
