{
  "fleet_profile": {
    "name": "华东夜航车队",
    "locale": "zh-CN",
    "owner": "ops-platform",
    "revision": 7
  },
  "service_order": [
    "perception",
    "planning",
    "guardian"
  ],
  "services": {
    "perception": {
      "enabled": true,
      "rollout": {
        "strategy": "canary",
        "batches": [10, 30, 60]
      },
      "endpoints": [
        "grpc://perception.internal:50051",
        "http://perception-metrics.internal:9090"
      ]
    },
    "planning": {
      "enabled": true,
      "rollout": {
        "strategy": "staged",
        "batches": [25, 50, 100]
      },
      "endpoints": [
        "grpc://planning.internal:50052"
      ]
    },
    "guardian": {
      "enabled": false,
      "rollout": {
        "strategy": "manual",
        "batches": [100]
      },
      "endpoints": [
        "http://guardian.internal:8088/health"
      ]
    }
  },
  "thresholds": {
    "max_lateral_error_m": 0.42,
    "max_brake_temp_c": 610,
    "min_sensor_score": 0.88
  },
  "threshold_order": [
    "max_lateral_error_m",
    "max_brake_temp_c",
    "min_sensor_score"
  ],
  "notification_templates": [
    {
      "channel": "slack",
      "template": "夜航巡检完成，请确认部署窗口",
      "recipients": ["#ops-night", "#sre-watch"]
    },
    {
      "channel": "email",
      "template": "请在15分钟内确认回滚预案",
      "recipients": ["fleet-ops@example.com", "duty-manager@example.com"]
    }
  ]
}
