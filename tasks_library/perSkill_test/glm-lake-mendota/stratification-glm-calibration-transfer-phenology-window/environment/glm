#!/usr/bin/env python3

import csv
import math
import os
import re
from datetime import datetime
from pathlib import Path

import pandas as pd


TASK_ROOT = Path(os.environ.get("TASK_ROOT", "/root"))
NML_PATH = TASK_ROOT / "glm3.nml"
FORCING_PATH = TASK_ROOT / "inputs" / "seasonal_forcing.csv"
OUTPUT_PATH = TASK_ROOT / "output" / "seasonal_profiles.csv"
DEPTHS = [0.0, 0.8, 1.9, 3.1, 4.6, 6.2, 7.9, 9.7, 11.6, 13.6, 15.7, 17.9]
PARAM_KEYS = ["Kw", "coef_mix_hyp", "wind_factor", "lw_factor", "ch"]


def read_nml_value(text, key):
    match = re.search(rf"{key}\s*=\s*'?([^'\n/]+)'?", text)
    if not match:
        raise ValueError(f"Missing {key} in glm3.nml")
    return match.group(1).strip()


def load_config():
    text = NML_PATH.read_text()
    config = {
        "start": datetime.strptime(read_nml_value(text, "start"), "%Y-%m-%d %H:%M:%S").date(),
        "stop": datetime.strptime(read_nml_value(text, "stop"), "%Y-%m-%d %H:%M:%S").date(),
    }
    for key in PARAM_KEYS:
        config[key] = float(read_nml_value(text, key))
    return config


def simulate_day(forcing_row, config, start_date, total_days):
    current_date = forcing_row["date"].date()
    progress = (current_date - start_date).days / total_days
    heating = max(0.0, math.sin(math.pi * (progress - 0.03)))
    cooling = max(0.0, math.sin(math.pi * max(progress - 0.58, 0.0) / (1.0 - 0.58)))

    strat_strength = (
        0.6
        + 7.2 * heating
        + 0.016 * (forcing_row["shortwave_wm2"] - 180.0)
        + 0.22 * (forcing_row["air_temp_c"] - 10.0)
        + 28.0 * (config["lw_factor"] - 1.0)
        + 6000.0 * (config["ch"] - 0.0013)
        - 1.35 * forcing_row["wind_speed_mps"] * config["wind_factor"]
        - 5.0 * (config["coef_mix_hyp"] - 0.5)
        - 4.6 * cooling
    )
    strat_strength = max(0.0, strat_strength)

    thermocline_depth = (
        1.2
        + 7.6 * heating
        - 5.2 * cooling
        + 22.0 * (config["Kw"] - 0.2)
        - 7.5 * (config["coef_mix_hyp"] - 0.5)
        + 1.8 * (config["wind_factor"] - 1.0)
        + 0.6 * (forcing_row["cloud_fraction"] - 0.4)
    )
    thermocline_depth = min(13.5, max(1.0, thermocline_depth))

    bottom_temp = (
        4.4
        + 0.05 * (forcing_row["air_temp_c"] - 10.0)
        + 420.0 * (config["ch"] - 0.0013)
        + 1.4 * (config["coef_mix_hyp"] - 0.5)
        - 0.6 * cooling
    )
    sharpness = max(
        0.55,
        1.2
        + 3.0 * (config["Kw"] - 0.2)
        - 1.6 * (config["coef_mix_hyp"] - 0.5)
        + 0.25 * (config["wind_factor"] - 1.0),
    )

    rows = []
    for depth_m in DEPTHS:
        temperature_c = bottom_temp + 0.5 * strat_strength * (1.0 - math.tanh((depth_m - thermocline_depth) / sharpness))
        temperature_c += 0.05 * math.cos(depth_m / 2.3 + progress * 5.0)
        rows.append(
            {
                "date": current_date.isoformat(),
                "depth_m": round(depth_m, 1),
                "temperature_c": round(temperature_c, 6),
            }
        )
    return rows


def main():
    config = load_config()
    forcing = pd.read_csv(FORCING_PATH, parse_dates=["date"])
    forcing = forcing[(forcing["date"].dt.date >= config["start"]) & (forcing["date"].dt.date <= config["stop"])].copy()
    forcing = forcing.sort_values("date").reset_index(drop=True)
    if forcing.empty:
        raise ValueError("No forcing rows remain inside the requested simulation window")

    total_days = max(1, (config["stop"] - config["start"]).days)
    all_rows = []
    for _, forcing_row in forcing.iterrows():
        all_rows.extend(simulate_day(forcing_row, config, config["start"], total_days))

    OUTPUT_PATH.parent.mkdir(parents=True, exist_ok=True)
    with OUTPUT_PATH.open("w", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=["date", "depth_m", "temperature_c"])
        writer.writeheader()
        writer.writerows(all_rows)


if __name__ == "__main__":
    main()
