#!/usr/bin/env python3

import csv
import math
import os
import re
from datetime import datetime
from pathlib import Path

import pandas as pd


TASK_ROOT = Path(os.environ.get("TASK_ROOT", "/root"))
NML_PATH = TASK_ROOT / "glm3.nml"
FORCING_PATH = TASK_ROOT / "inputs" / "winter_forcing.csv"
OUTPUT_PATH = TASK_ROOT / "output" / "under_ice_profiles.csv"
DEPTHS = [0.0, 1.0, 2.0, 3.5, 5.0, 6.5, 8.0, 10.0, 12.0]
PARAM_KEYS = ["Kw", "coef_mix_hyp", "wind_factor", "lw_factor", "ch"]


def read_nml_value(text, key):
    match = re.search(rf"{key}\s*=\s*'?([^'\n/]+)'?", text)
    if not match:
        raise ValueError(f"Missing {key} in glm3.nml")
    return match.group(1).strip()


def load_config():
    text = NML_PATH.read_text()
    config = {
        "start": datetime.strptime(read_nml_value(text, "start"), "%Y-%m-%d %H:%M:%S").date(),
        "stop": datetime.strptime(read_nml_value(text, "stop"), "%Y-%m-%d %H:%M:%S").date(),
    }
    for key in PARAM_KEYS:
        config[key] = float(read_nml_value(text, key))
    return config


def simulate_day(forcing_row, config, total_days):
    current_date = forcing_row["date"].date()
    progress = (current_date - config["start"]).days / total_days
    freeze_core = max(0.0, -forcing_row["air_temp_c"] - 0.5)
    seasonal = max(0.0, math.sin(math.pi * progress))

    ice_signal = (
        0.55 * freeze_core
        + 0.08 * forcing_row["snow_cm"]
        + 0.95 * seasonal
        - 0.006 * forcing_row["shortwave_wm2"]
        - 0.24 * forcing_row["wind_speed_mps"] * config["wind_factor"]
        + 10.5 * (config["Kw"] - 0.24)
        - 6.5 * (config["coef_mix_hyp"] - 0.48)
        - 5200.0 * (config["ch"] - 0.0011)
        - 2.1 * (config["lw_factor"] - 0.95)
    )
    ice_thickness = max(0.0, min(0.85, 0.04 * ice_signal))

    surface_temp = (
        0.28
        - 0.55 * ice_thickness
        + 0.004 * forcing_row["shortwave_wm2"]
        - 0.015 * freeze_core
        + 0.9 * (config["lw_factor"] - 0.95)
        + 450.0 * (config["ch"] - 0.0011)
        - 0.16 * (config["Kw"] - 0.24)
    )
    surface_temp = max(-0.05, min(0.65, surface_temp))

    bottom_temp = (
        3.25
        + 0.18 * forcing_row["inflow_temp_c"]
        + 1.8 * (config["Kw"] - 0.24)
        + 1.3 * (config["lw_factor"] - 0.95)
        + 3.6 * (config["coef_mix_hyp"] - 0.48)
        - 1.05 * (config["wind_factor"] - 1.0)
        + 850.0 * (config["ch"] - 0.0011)
        - 0.12 * ice_thickness
    )

    inversion_center = (
        2.4
        + 5.8 * ice_thickness
        + 10.0 * (config["Kw"] - 0.24)
        - 7.2 * (config["coef_mix_hyp"] - 0.48)
        + 2.0 * (config["wind_factor"] - 1.0)
        - 4.0 * (config["lw_factor"] - 0.95)
        - 1600.0 * (config["ch"] - 0.0011)
    )
    inversion_center = max(1.2, min(11.0, inversion_center))

    sharpness = max(
        0.8,
        1.25
        + 2.2 * (config["Kw"] - 0.24)
        - 1.4 * (config["coef_mix_hyp"] - 0.48)
        + 0.35 * (config["wind_factor"] - 1.0),
    )

    rows = []
    for depth_m in DEPTHS:
        logistic = 0.5 * (1.0 + math.tanh((depth_m - inversion_center) / sharpness))
        temperature_c = surface_temp + (bottom_temp - surface_temp) * logistic
        temperature_c += 0.04 * math.cos(depth_m / 1.8 + progress * 4.5)
        rows.append(
            {
                "date": current_date.isoformat(),
                "depth_m": round(depth_m, 1),
                "temperature_c": round(float(temperature_c), 6),
                "ice_thickness_m": round(float(ice_thickness), 6),
            }
        )
    return rows


def main():
    config = load_config()
    forcing = pd.read_csv(FORCING_PATH, parse_dates=["date"])
    forcing = forcing[(forcing["date"].dt.date >= config["start"]) & (forcing["date"].dt.date <= config["stop"])].copy()
    forcing = forcing.sort_values("date").reset_index(drop=True)
    if forcing.empty:
        raise ValueError("No forcing rows remain inside the simulation window")

    total_days = max(1, (config["stop"] - config["start"]).days)
    rows = []
    for _, forcing_row in forcing.iterrows():
        rows.extend(simulate_day(forcing_row, config, total_days))

    OUTPUT_PATH.parent.mkdir(parents=True, exist_ok=True)
    with OUTPUT_PATH.open("w", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=["date", "depth_m", "temperature_c", "ice_thickness_m"])
        writer.writeheader()
        writer.writerows(rows)


if __name__ == "__main__":
    main()
