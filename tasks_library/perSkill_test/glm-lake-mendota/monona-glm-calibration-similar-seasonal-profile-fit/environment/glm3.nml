&glm_setup
   sim_name = 'Monona seasonal fit'
   max_layers = 180
   min_layer_vol = 0.050
   min_layer_thick = 0.15
   max_layer_thick = 0.75
/
&time
   timefmt = 2
   start = '2012-01-01 00:00:00'
   stop = '2013-12-31 00:00:00'
   dt = 86400
   timezone = -6
/
&morphometry
   lake_name = 'Monona'
   latitude = 43.05
   longitude = -89.32
   lake_depth = 23
/
&light
   Kw = 0.30
/
&mixing
   coef_mix_hyp = 0.50
/
&meteorology
   meteo_fl = 'inputs/monona_forcing.csv'
   wind_factor = 1.00
   lw_factor = 1.00
   ch = 0.00130
/
