{
  "text_file": "sys/linux/dev_ppdiag.txt",
  "const_file": "sys/linux/dev_ppdiag.txt.const",
  "arch_line": "arches = amd64, 386",
  "required_regexes": [
    {
      "pattern": "resource\\s+fd_ppdiag\\s*\\[\\s*fd\\s*\\]",
      "message": "resource must be fd_ppdiag"
    },
    {
      "pattern": "syz_open_dev\\$ppdiag\\s*\\([^\\n]*\\)\\s+fd_ppdiag",
      "message": "opener must return fd_ppdiag"
    },
    {
      "pattern": "ioctl\\$PPDIAG_GETMODE\\s*\\([^\\n]*ptr\\s*\\[\\s*out\\s*,\\s*int32\\s*\\]",
      "message": "PPDIAG_GETMODE must use ptr[out, int32]"
    },
    {
      "pattern": "ioctl\\$PPDIAG_SETMODE\\s*\\([^\\n]*ptr\\s*\\[\\s*in\\s*,\\s*flags\\[ppdiag_modes,\\s*int32\\]\\s*\\]",
      "message": "PPDIAG_SETMODE must use ptr[in, flags[ppdiag_modes, int32]]"
    },
    {
      "pattern": "ioctl\\$PPDIAG_FROB\\s*\\([^\\n]*ptr\\s*\\[\\s*in\\s*,\\s*ppdiag_window\\s*\\]",
      "message": "PPDIAG_FROB must use ptr[in, ppdiag_window]"
    }
  ],
  "constants": {
    "PPDIAG_CLAIM": 28736,
    "PPDIAG_RELEASE": 28737,
    "PPDIAG_GETMODE": 2147774530,
    "PPDIAG_SETMODE": 1074032707,
    "PPDIAG_FROB": 1073901638
  },
  "forbidden_substrings": [
    "TODO",
    "???"
  ]
}
