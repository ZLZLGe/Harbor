{
  "text_file": "sys/linux/dev_sensorhub_ctl.txt",
  "const_file": "sys/linux/dev_sensorhub_ctl.txt.const",
  "arch_line": "arches = amd64, 386",
  "required_regexes": [
    {
      "pattern": "resource\\s+fd_sensorhub\\s*\\[\\s*fd\\s*\\]",
      "message": "resource must be fd_sensorhub"
    },
    {
      "pattern": "syz_open_dev\\$sensorhub\\s*\\([^\\n]*\\)\\s+fd_sensorhub",
      "message": "opener must return fd_sensorhub"
    },
    {
      "pattern": "sensor_modes\\s*=\\s*SENSOR_MODE_IDLE,\\s*SENSOR_MODE_FAST,\\s*SENSOR_MODE_STREAM",
      "message": "sensor_modes flags are wrong"
    },
    {
      "pattern": "ioctl\\$SNS_GET_SNAPSHOT\\s*\\([^\\n]*ptr\\s*\\[\\s*out\\s*,\\s*sensor_snapshot\\s*\\]",
      "message": "SNS_GET_SNAPSHOT must use ptr[out, sensor_snapshot]"
    },
    {
      "pattern": "ioctl\\$SNS_SET_THRESH\\s*\\([^\\n]*ptr\\s*\\[\\s*in\\s*,\\s*sensor_threshold\\s*\\]",
      "message": "SNS_SET_THRESH must use ptr[in, sensor_threshold]"
    }
  ],
  "constants": {
    "SNS_GET_SNAPSHOT": 2148168466,
    "SNS_SET_MODE": 1074033428,
    "SENSOR_MODE_STREAM": 2
  }
}
