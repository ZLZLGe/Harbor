{
  "text_file": "sys/linux/dev_bridge_port.txt",
  "const_file": "sys/linux/dev_bridge_port.txt.const",
  "arch_line": "arches = amd64, 386",
  "required_regexes": [
    {
      "pattern": "resource\\s+fd_bridgectl\\s*\\[\\s*fd\\s*\\]",
      "message": "resource must be fd_bridgectl"
    },
    {
      "pattern": "syz_open_dev\\$bridgectl\\s*\\([^\\n]*\\)\\s+fd_bridgectl",
      "message": "opener must return fd_bridgectl"
    },
    {
      "pattern": "ioctl\\$BPORT_QUERY_PORT\\s*\\([^\\n]*ptr\\s*\\[\\s*inout\\s*,\\s*ifreq_t\\[int16\\]\\s*\\]",
      "message": "BPORT_QUERY_PORT must use ptr[inout, ifreq_t[int16]]"
    },
    {
      "pattern": "ioctl\\$BPORT_GET_INDEX\\s*\\([^\\n]*ptr\\s*\\[\\s*out\\s*,\\s*int32\\s*\\]",
      "message": "BPORT_GET_INDEX must use ptr[out, int32]"
    }
  ],
  "constants": {
    "BPORT_QUERY_PORT": 3221381713,
    "BR_PORT_FLOOD": 16
  }
}
