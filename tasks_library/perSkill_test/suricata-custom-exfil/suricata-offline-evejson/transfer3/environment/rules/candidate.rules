alert http any any -> any any (msg:"Daily baseline report"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/ops/daily"; http.header; content:"X-Window|3a| baseline"; nocase; http.request_body; pcre:"/(?:^|&)report=daily(?:&|$)/"; pcre:"/(?:^|&)digest=[0-9a-fA-F]{32}(?:&|$)/"; sid:2000001; rev:1;)
alert http any any -> any any (msg:"Weekly canary report"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/ops/weekly"; http.header; content:"X-Change-Window|3a| canary"; nocase; http.request_body; pcre:"/(?:^|&)report=weekly(?:&|$)/"; pcre:"/(?:^|&)sites=[0-9]{2}(?:&|$)/"; sid:2000002; rev:1;)
alert http any any -> any any (msg:"Bulk export push"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/ops/export"; http.header; content:"X-Export-Class|3a| bulk"; nocase; http.request_body; pcre:"/(?:^|&)file=[A-Za-z0-9._-]+\\.csv(?:&|$)/"; pcre:"/(?:^|&)rows=[5-9][0-9]{3,}(?:&|$)/"; sid:2000003; rev:1;)
