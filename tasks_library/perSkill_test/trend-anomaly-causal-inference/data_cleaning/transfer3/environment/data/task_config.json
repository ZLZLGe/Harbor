{
  "input_file": "/root/data/raw.csv",
  "output_file": "/root/transfer3_applicant_intake_cleaned.csv",
  "summary_file": "/root/transfer3_applicant_intake_summary.json",
  "pipeline_name": "Applicant Intake",
  "steps": [
    {
      "strategy": "remove_duplicates",
      "description": "Remove duplicate intake records",
      "kwargs": {
        "subset": [
          "applicant_id",
          "intake_date",
          "program_track",
          "pledge_amount"
        ]
      }
    },
    {
      "strategy": "drop_missing",
      "description": "Drop rows missing applicant, date, or track",
      "kwargs": {
        "columns": [
          "applicant_id",
          "intake_date",
          "program_track"
        ]
      }
    },
    {
      "strategy": "process_text",
      "description": "Extract household member counts",
      "kwargs": {
        "columns": [
          "household_members"
        ],
        "operation": "extract_numbers"
      }
    },
    {
      "strategy": "impute_median",
      "description": "Impute missing household counts",
      "kwargs": {
        "columns": [
          "household_members"
        ]
      }
    },
    {
      "strategy": "process_text",
      "description": "Extract counselor emails",
      "kwargs": {
        "columns": [
          "counselor_email"
        ],
        "operation": "extract_email"
      }
    },
    {
      "strategy": "cap_outliers_iqr",
      "description": "Cap extreme pledge amounts",
      "kwargs": {
        "columns": [
          "pledge_amount"
        ],
        "multiplier": 1.5
      }
    }
  ],
  "numeric_columns": [
    "household_members",
    "pledge_amount"
  ],
  "strip_columns": [],
  "sort_by": [
    "applicant_id",
    "intake_date"
  ]
}
