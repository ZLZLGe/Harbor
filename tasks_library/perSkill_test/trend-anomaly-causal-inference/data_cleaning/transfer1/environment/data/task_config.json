{
  "input_file": "/root/data/raw.csv",
  "output_file": "/root/transfer1_ward_inventory_cleaned.csv",
  "summary_file": "/root/transfer1_ward_inventory_summary.json",
  "pipeline_name": "Ward Inventory",
  "steps": [
    {
      "strategy": "remove_duplicates",
      "description": "Remove duplicate usage entries",
      "kwargs": {
        "subset": [
          "item_id",
          "shift_date",
          "ward",
          "units_used"
        ]
      }
    },
    {
      "strategy": "drop_missing",
      "description": "Drop rows missing item, date, or ward",
      "kwargs": {
        "columns": [
          "item_id",
          "shift_date",
          "ward"
        ]
      }
    },
    {
      "strategy": "process_text",
      "description": "Extract restock day counts",
      "kwargs": {
        "columns": [
          "restock_note"
        ],
        "operation": "extract_numbers"
      }
    },
    {
      "strategy": "impute_median",
      "description": "Impute missing restock day counts",
      "kwargs": {
        "columns": [
          "restock_note"
        ]
      }
    },
    {
      "strategy": "process_text",
      "description": "Extract supervisor emails",
      "kwargs": {
        "columns": [
          "supervisor_email"
        ],
        "operation": "extract_email"
      }
    },
    {
      "strategy": "cap_outliers_iqr",
      "description": "Cap extreme usage spikes",
      "kwargs": {
        "columns": [
          "units_used"
        ],
        "multiplier": 1.5
      }
    }
  ],
  "numeric_columns": [
    "restock_note",
    "units_used"
  ],
  "strip_columns": [],
  "sort_by": [
    "item_id",
    "shift_date"
  ]
}
