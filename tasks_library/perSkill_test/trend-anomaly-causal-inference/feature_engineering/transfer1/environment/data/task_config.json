{
  "input_file": "/root/data/raw.csv",
  "output_file": "/root/transfer1_donor_features.csv",
  "summary_file": "/root/transfer1_donor_features_summary.json",
  "id_column": "donor_id",
  "pipeline_name": "Donor Features",
  "steps": [
    {
      "strategy": "convert_to_binary",
      "description": "Binary encode volunteer history",
      "kwargs": {
        "columns": [
          "volunteered_last_year"
        ]
      }
    },
    {
      "strategy": "encode_categorical",
      "description": "One-hot encode donor segment and channel",
      "kwargs": {
        "columns": [
          "donor_segment",
          "channel_pref"
        ],
        "method": "onehot"
      }
    },
    {
      "strategy": "scale_numerical",
      "description": "Min-max scale outreach metrics",
      "kwargs": {
        "columns": [
          "annual_gift",
          "calls_completed"
        ],
        "method": "minmax"
      }
    },
    {
      "strategy": "create_interaction_features",
      "description": "Create giving-contact interaction",
      "kwargs": {
        "column_pairs": [
          [
            "annual_gift",
            "calls_completed"
          ]
        ]
      }
    },
    {
      "strategy": "validate_no_constants",
      "description": "Drop constant columns",
      "kwargs": {
        "exclude_cols": [
          "donor_id"
        ]
      }
    },
    {
      "strategy": "validate_numeric_features",
      "description": "Validate numeric output",
      "kwargs": {
        "exclude_cols": [
          "donor_id"
        ]
      }
    }
  ]
}
