{
  "input_file": "/root/data/raw.csv",
  "output_file": "/root/similar_member_features.csv",
  "summary_file": "/root/similar_member_features_summary.json",
  "id_column": "member_id",
  "pipeline_name": "Member Features",
  "steps": [
    {
      "strategy": "convert_to_binary",
      "description": "Binary encode newsletter opt-in",
      "kwargs": {
        "columns": [
          "newsletter_opt_in"
        ]
      }
    },
    {
      "strategy": "encode_categorical",
      "description": "One-hot encode membership and region",
      "kwargs": {
        "columns": [
          "membership_tier",
          "region"
        ],
        "method": "onehot"
      }
    },
    {
      "strategy": "scale_numerical",
      "description": "Min-max scale continuous fields",
      "kwargs": {
        "columns": [
          "age",
          "household_income",
          "months_active"
        ],
        "method": "minmax"
      }
    },
    {
      "strategy": "create_interaction_features",
      "description": "Create age-tenure interaction",
      "kwargs": {
        "column_pairs": [
          [
            "age",
            "months_active"
          ]
        ]
      }
    },
    {
      "strategy": "validate_no_constants",
      "description": "Drop constant columns",
      "kwargs": {
        "exclude_cols": [
          "member_id"
        ]
      }
    },
    {
      "strategy": "validate_numeric_features",
      "description": "Validate numeric output",
      "kwargs": {
        "exclude_cols": [
          "member_id"
        ]
      }
    }
  ]
}
