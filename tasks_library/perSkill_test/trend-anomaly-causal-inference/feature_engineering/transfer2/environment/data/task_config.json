{
  "input_file": "/root/data/raw.csv",
  "output_file": "/root/transfer2_rider_features.csv",
  "summary_file": "/root/transfer2_rider_features_summary.json",
  "id_column": "rider_id",
  "pipeline_name": "Rider Features",
  "steps": [
    {
      "strategy": "convert_to_binary",
      "description": "Binary encode auto reload",
      "kwargs": {
        "columns": [
          "auto_reload"
        ]
      }
    },
    {
      "strategy": "encode_categorical",
      "description": "One-hot encode fare type and zone",
      "kwargs": {
        "columns": [
          "fare_type",
          "home_zone"
        ],
        "method": "onehot"
      }
    },
    {
      "strategy": "scale_numerical",
      "description": "Min-max scale trip metrics",
      "kwargs": {
        "columns": [
          "avg_trip_minutes",
          "monthly_trips"
        ],
        "method": "minmax"
      }
    },
    {
      "strategy": "create_interaction_features",
      "description": "Create trip-time interaction",
      "kwargs": {
        "column_pairs": [
          [
            "avg_trip_minutes",
            "monthly_trips"
          ]
        ]
      }
    },
    {
      "strategy": "validate_no_constants",
      "description": "Drop constant columns",
      "kwargs": {
        "exclude_cols": [
          "rider_id"
        ]
      }
    },
    {
      "strategy": "validate_numeric_features",
      "description": "Validate numeric output",
      "kwargs": {
        "exclude_cols": [
          "rider_id"
        ]
      }
    }
  ]
}
