{
  "input_file": "/root/data/raw.csv",
  "output_file": "/root/transfer3_intake_features.csv",
  "summary_file": "/root/transfer3_intake_features_summary.json",
  "id_column": "patient_id",
  "pipeline_name": "Intake Features",
  "steps": [
    {
      "strategy": "convert_to_binary",
      "description": "Binary encode portal activity",
      "kwargs": {
        "columns": [
          "portal_active"
        ]
      }
    },
    {
      "strategy": "encode_categorical",
      "description": "One-hot encode triage band and district",
      "kwargs": {
        "columns": [
          "triage_band",
          "district"
        ],
        "method": "onehot"
      }
    },
    {
      "strategy": "scale_numerical",
      "description": "Min-max scale clinical counts",
      "kwargs": {
        "columns": [
          "bmi",
          "visits_last_year"
        ],
        "method": "minmax"
      }
    },
    {
      "strategy": "create_interaction_features",
      "description": "Create bmi-visit interaction",
      "kwargs": {
        "column_pairs": [
          [
            "bmi",
            "visits_last_year"
          ]
        ]
      }
    },
    {
      "strategy": "validate_no_constants",
      "description": "Drop constant columns",
      "kwargs": {
        "exclude_cols": [
          "patient_id"
        ]
      }
    },
    {
      "strategy": "validate_numeric_features",
      "description": "Validate numeric output",
      "kwargs": {
        "exclude_cols": [
          "patient_id"
        ]
      }
    }
  ]
}
