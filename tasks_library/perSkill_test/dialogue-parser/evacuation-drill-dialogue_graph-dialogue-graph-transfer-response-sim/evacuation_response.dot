digraph EvacuationResponse {
  rankdir=TB;
  node [fontname="Arial", fontsize="10"];
  edge [fontname="Arial", fontsize="8"];
  End [label="END", shape=doublecircle, style=filled, fillcolor="lightgray"];
  "Start" [label="Start\\nPA System: Attention team, this is a scheduled evacuation drill for Harbor Tower. Report status through the command channel.", shape=box, style="filled,rounded", fillcolor="white"];
  "BroadcastHub" [label="BroadcastHub", shape=diamond, style=filled, fillcolor="lightblue"];
  "Floor2Ready" [label="Floor2Ready\\nSafety Warden: Floor 2 is sweeping west to east and guiding staff toward Stair A.", shape=box, style="filled,rounded", fillcolor="white"];
  "Floor2SweepChoice" [label="Floor2SweepChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "StairDispatch" [label="StairDispatch\\nSafety Warden: Staff from Floor 2 are entering Stair A in an orderly line.", shape=box, style="filled,rounded", fillcolor="white"];
  "LateOccupant" [label="LateOccupant\\nSafety Warden: The finance office is still occupied and needs a second knock.", shape=box, style="filled,rounded", fillcolor="white"];
  "OccupantFollowup" [label="OccupantFollowup", shape=diamond, style=filled, fillcolor="lightblue"];
  "Floor2Escalation" [label="Floor2Escalation\\nCommand Chief: Send a backup checker to Floor 2 and keep that zone closed until contact is confirmed.", shape=box, style="filled,rounded", fillcolor="white"];
  "Floor5Blocked" [label="Floor5Blocked\\nSafety Warden: The south fire door on Floor 5 is not latching open for the lab team.", shape=box, style="filled,rounded", fillcolor="white"];
  "Floor5Choice" [label="Floor5Choice", shape=diamond, style=filled, fillcolor="lightblue"];
  "EastStairRoute" [label="EastStairRoute\\nSafety Warden: Lab staff are being redirected to the east stairs with the aisle kept clear.", shape=box, style="filled,rounded", fillcolor="white"];
  "EastStairCheck" [label="EastStairCheck", shape=diamond, style=filled, fillcolor="lightblue"];
  "EngineeringDispatch" [label="EngineeringDispatch\\nEngineer: Engineering is on the way to inspect the blocked fire door.", shape=box, style="filled,rounded", fillcolor="white"];
  "EngineeringChoice" [label="EngineeringChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "FireDoorFailure" [label="FireDoorFailure\\nCommand Chief: Keep Floor 5 on alternate routing and log the blocked door as a corrective action.", shape=box, style="filled,rounded", fillcolor="white"];
  "Floor5Resweep" [label="Floor5Resweep\\nSafety Warden: The Floor 5 team is re-running the sweep after the route change.", shape=box, style="filled,rounded", fillcolor="white"];
  "ResweepChoice" [label="ResweepChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "SecureCabinet" [label="SecureCabinet\\nSafety Warden: The last lab worker is securing the chemical cabinet before exiting.", shape=box, style="filled,rounded", fillcolor="white"];
  "LobbyCheck" [label="LobbyCheck\\nReception: The lobby desk is matching visitor badges against the sign-in sheet.", shape=box, style="filled,rounded", fillcolor="white"];
  "LobbyChoice" [label="LobbyChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "ContractorSearch" [label="ContractorSearch\\nReception: One contractor badge is missing from the roll call and the vendor was last checked in upstairs.", shape=box, style="filled,rounded", fillcolor="white"];
  "ContractorChoice" [label="ContractorChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "RadioFallback" [label="RadioFallback\\nReception: The front desk radio has dropped off the command channel.", shape=box, style="filled,rounded", fillcolor="white"];
  "FallbackChoice" [label="FallbackChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "RunnerDispatch" [label="RunnerDispatch\\nReception: A runner is carrying the visitor sheet to the command desk by hand.", shape=box, style="filled,rounded", fillcolor="white"];
  "MobilityAssist" [label="MobilityAssist\\nAccessibility Lead: A mobility-assisted evacuee is waiting near the refuge area and needs routing guidance.", shape=box, style="filled,rounded", fillcolor="white"];
  "MobilityChoice" [label="MobilityChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "StairChairDeploy" [label="StairChairDeploy\\nAccessibility Lead: The stair-chair team is moving to the refuge area with a spotter on Stair B.", shape=box, style="filled,rounded", fillcolor="white"];
  "StairChairOutcome" [label="StairChairOutcome", shape=diamond, style=filled, fillcolor="lightblue"];
  "RefugeMonitor" [label="RefugeMonitor\\nAccessibility Lead: The evacuee remains calm in the refuge area while command evaluates timing.", shape=box, style="filled,rounded", fillcolor="white"];
  "RefugeChoice" [label="RefugeChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "ElevatorDenied" [label="ElevatorDenied\\nCommand Chief: Elevators stay out of service during the drill; redirect the request to the assisted-descent procedure.", shape=box, style="filled,rounded", fillcolor="white"];
  "CrowdControl" [label="CrowdControl\\nAssembly Lead: Stair traffic is bunching up and needs spacing before the next team descends.", shape=box, style="filled,rounded", fillcolor="white"];
  "CrowdControlChoice" [label="CrowdControlChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "CommandReview" [label="CommandReview\\nCommand Chief: Command is comparing floor reports, visitor counts, and assembly updates.", shape=box, style="filled,rounded", fillcolor="white"];
  "ClearStatusChoice" [label="ClearStatusChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "HeadcountConfirm" [label="HeadcountConfirm\\nAssembly Lead: Every badge and visitor tag is accounted for at the assembly area.", shape=box, style="filled,rounded", fillcolor="white"];
  "DrillCloseChoice" [label="DrillCloseChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "DrillSuccess" [label="DrillSuccess\\nPA System: Drill complete. Return teams to normal operations after the debrief.", shape=box, style="filled,rounded", fillcolor="white"];
  "DrillCorrective" [label="DrillCorrective\\nPA System: Drill complete. Keep the blocked-door review open for follow-up.", shape=box, style="filled,rounded", fillcolor="white"];
  "HeadcountMismatch" [label="HeadcountMismatch\\nAssembly Lead: Two badges are missing from the assembly roster.", shape=box, style="filled,rounded", fillcolor="white"];
  "HeadcountChoice" [label="HeadcountChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "ResweepDispatch" [label="ResweepDispatch\\nCommand Chief: Command is sending a targeted resweep based on the missing badge list.", shape=box, style="filled,rounded", fillcolor="white"];
  "ResweepDispatchChoice" [label="ResweepDispatchChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "ControllerInject" [label="ControllerInject\\nCommand Chief: The missing badges were part of the drill inject and no live occupants are unaccounted for.", shape=box, style="filled,rounded", fillcolor="white"];
  "ShelterInPlace" [label="ShelterInPlace\\nPA System: Weather has made the outdoor assembly point unsafe; move the drill to the covered garage.", shape=box, style="filled,rounded", fillcolor="white"];
  "ShelterChoice" [label="ShelterChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "CoveredGarage" [label="CoveredGarage\\nAssembly Lead: The covered garage is now the temporary assembly location with headcount restarting there.", shape=box, style="filled,rounded", fillcolor="white"];
  "BroadcastRepeat" [label="BroadcastRepeat\\nPA System: Repeat the last status request and keep the routes clear until command confirms the next move.", shape=box, style="filled,rounded", fillcolor="white"];
  "BroadcastRepeatChoice" [label="BroadcastRepeatChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "AssemblyUpdate" [label="AssemblyUpdate\\nAssembly Lead: The assembly point has received another team and updated the roster.", shape=box, style="filled,rounded", fillcolor="white"];
  "AssemblyChoice" [label="AssemblyChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "Start" -> "BroadcastHub";
  "BroadcastHub" -> "Floor2Ready" [label="1. Acknowledge the call as Floor 2 warden."];
  "BroadcastHub" -> "Floor5Blocked" [label="2. Report a blocked fire door on Floor 5."];
  "BroadcastHub" -> "LobbyCheck" [label="3. Confirm lobby visitors and contractors."];
  "BroadcastHub" -> "MobilityAssist" [label="4. Request mobility assistance routing."];
  "BroadcastHub" -> "CommandReview" [label="5. Review building-wide status at command."];
  "Floor2Ready" -> "Floor2SweepChoice";
  "Floor2SweepChoice" -> "StairDispatch" [label="1. West wing is clear."];
  "Floor2SweepChoice" -> "LateOccupant" [label="2. One office is still occupied."];
  "Floor2SweepChoice" -> "BroadcastRepeat" [label="3. [Fallback] Radio message was unclear, repeat the broadcast."];
  "StairDispatch" -> "AssemblyUpdate";
  "LateOccupant" -> "OccupantFollowup";
  "OccupantFollowup" -> "StairDispatch" [label="1. The employee exits toward Stair A."];
  "OccupantFollowup" -> "MobilityAssist" [label="2. The employee reports ankle pain."];
  "OccupantFollowup" -> "Floor2Escalation" [label="3. There is still no response from the office."];
  "Floor2Escalation" -> "CommandReview";
  "Floor5Blocked" -> "Floor5Choice";
  "Floor5Choice" -> "EastStairRoute" [label="1. Route the lab team to the east stairs."];
  "Floor5Choice" -> "Floor5Resweep" [label="2. [Fallback] Reset the door magnet and try again."];
  "Floor5Choice" -> "EngineeringDispatch" [label="3. Call engineering to inspect the door."];
  "EastStairRoute" -> "EastStairCheck";
  "EastStairCheck" -> "AssemblyUpdate" [label="1. The east stairs stay clear."];
  "EastStairCheck" -> "CrowdControl" [label="2. The east stairs are crowded."];
  "EastStairCheck" -> "SecureCabinet" [label="3. The chem cabinet was left unsecured."];
  "EngineeringDispatch" -> "EngineeringChoice";
  "EngineeringChoice" -> "FireDoorFailure" [label="1. The door remains blocked after inspection."];
  "EngineeringChoice" -> "Floor5Resweep" [label="2. The door opens after inspection."];
  "FireDoorFailure" -> "CommandReview";
  "Floor5Resweep" -> "ResweepChoice";
  "ResweepChoice" -> "AssemblyUpdate" [label="1. Floor 5 is now clear."];
  "ResweepChoice" -> "SecureCabinet" [label="2. A chem cabinet still needs to be secured."];
  "ResweepChoice" -> "BroadcastRepeat" [label="3. Another broadcast reminder is needed."];
  "SecureCabinet" -> "Floor5Resweep";
  "LobbyCheck" -> "LobbyChoice";
  "LobbyChoice" -> "AssemblyUpdate" [label="1. Every visitor matches the log."];
  "LobbyChoice" -> "ContractorSearch" [label="2. One contractor badge is missing."];
  "LobbyChoice" -> "RadioFallback" [label="3. [Fallback] The lobby radio failed."];
  "ContractorSearch" -> "ContractorChoice";
  "ContractorChoice" -> "AssemblyUpdate" [label="1. The contractor is already at the assembly point."];
  "ContractorChoice" -> "Floor2Escalation" [label="2. The contractor was last seen on Floor 2."];
  "ContractorChoice" -> "Floor5Blocked" [label="3. The contractor was in the Floor 5 lab."];
  "RadioFallback" -> "FallbackChoice";
  "FallbackChoice" -> "AssemblyUpdate" [label="1. [Fallback] Use the backup handset."];
  "FallbackChoice" -> "RunnerDispatch" [label="2. Send a runner to the command desk."];
  "FallbackChoice" -> "BroadcastRepeat" [label="3. Wait for command to call back."];
  "RunnerDispatch" -> "CommandReview";
  "MobilityAssist" -> "MobilityChoice";
  "MobilityChoice" -> "StairChairDeploy" [label="1. Dispatch the stair-chair team."];
  "MobilityChoice" -> "RefugeMonitor" [label="2. Hold position in the refuge area and monitor."];
  "MobilityChoice" -> "ElevatorDenied" [label="3. Someone requested the elevator by mistake."];
  "StairChairDeploy" -> "StairChairOutcome";
  "StairChairOutcome" -> "AssemblyUpdate" [label="1. The transfer reaches the stair landing."];
  "StairChairOutcome" -> "CrowdControl" [label="2. The stairs are too crowded for the transfer."];
  "StairChairOutcome" -> "RefugeMonitor" [label="3. The evacuee asks to pause in the refuge area."];
  "RefugeMonitor" -> "RefugeChoice";
  "RefugeChoice" -> "StairChairDeploy" [label="1. Command approves assisted descent now."];
  "RefugeChoice" -> "CommandReview" [label="2. Command keeps the refuge area occupied for the next cycle."];
  "RefugeChoice" -> "CrowdControl" [label="3. A second evacuee arrives and needs crowd control."];
  "ElevatorDenied" -> "MobilityChoice";
  "CrowdControl" -> "CrowdControlChoice";
  "CrowdControlChoice" -> "CommandReview" [label="1. Open the secondary stairwell."];
  "CrowdControlChoice" -> "RefugeMonitor" [label="2. Pause the descent and retry from the refuge area."];
  "CrowdControlChoice" -> "BroadcastRepeat" [label="3. Repeat the floor broadcast for spacing."];
  "CommandReview" -> "ClearStatusChoice";
  "ClearStatusChoice" -> "HeadcountConfirm" [label="1. All zones report clear."];
  "ClearStatusChoice" -> "Floor5Blocked" [label="2. Floor 5 still needs alternate routing."];
  "ClearStatusChoice" -> "HeadcountMismatch" [label="3. Headcount does not match at assembly."];
  "ClearStatusChoice" -> "ShelterInPlace" [label="4. Weather outside becomes unsafe."];
  "HeadcountConfirm" -> "DrillCloseChoice";
  "DrillCloseChoice" -> "DrillSuccess" [label="1. Close the drill as a clean run."];
  "DrillCloseChoice" -> "DrillCorrective" [label="2. Close the drill and log a corrective action."];
  "DrillCloseChoice" -> "CommandReview" [label="3. Recheck one more time before closing."];
  "DrillSuccess" -> "End";
  "DrillCorrective" -> "End";
  "HeadcountMismatch" -> "HeadcountChoice";
  "HeadcountChoice" -> "LobbyCheck" [label="1. Recheck the lobby sign-in sheets."];
  "HeadcountChoice" -> "ResweepDispatch" [label="2. Send a targeted resweep request."];
  "HeadcountChoice" -> "ControllerInject" [label="3. Treat it as a controller inject and continue."];
  "ResweepDispatch" -> "ResweepDispatchChoice";
  "ResweepDispatchChoice" -> "Floor2Ready" [label="1. Send the team back to Floor 2."];
  "ResweepDispatchChoice" -> "Floor5Blocked" [label="2. Send the team back to Floor 5."];
  "ResweepDispatchChoice" -> "MobilityAssist" [label="3. Ask accessibility staff to verify the refuge area."];
  "ControllerInject" -> "HeadcountConfirm";
  "ShelterInPlace" -> "ShelterChoice";
  "ShelterChoice" -> "CoveredGarage" [label="1. Move everyone to the covered garage."];
  "ShelterChoice" -> "BroadcastRepeat" [label="2. Pause and restart the floor broadcast."];
  "ShelterChoice" -> "CommandReview" [label="3. Keep the current assembly point and re-evaluate."];
  "CoveredGarage" -> "HeadcountConfirm";
  "BroadcastRepeat" -> "BroadcastRepeatChoice";
  "BroadcastRepeatChoice" -> "CommandReview" [label="1. Repeat the all-clear request."];
  "BroadcastRepeatChoice" -> "Floor2Ready" [label="2. Repeat Floor 2 sweep instructions."];
  "BroadcastRepeatChoice" -> "MobilityAssist" [label="3. Repeat mobility assistance instructions."];
  "AssemblyUpdate" -> "AssemblyChoice";
  "AssemblyChoice" -> "CommandReview" [label="1. Send the update to command."];
  "AssemblyChoice" -> "HeadcountMismatch" [label="2. Start a manual headcount check."];
  "AssemblyChoice" -> "LobbyCheck" [label="3. Ask lobby to verify visitor badges again."];
}
