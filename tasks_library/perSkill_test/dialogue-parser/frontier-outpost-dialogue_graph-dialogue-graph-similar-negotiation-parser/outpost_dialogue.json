    },
    {
      "from": "DelayChoice",
      "to": "GuildThreat",
      "text": "2. [Intimidate] Warn that the miners' guild will remember this."
    },
    {
      "from": "DelayChoice",
      "to": "NegotiationHub",
      "text": "3. Return to negotiations."
    },
    {
      "from": "BribeAttempt",
      "to": "Detained",
