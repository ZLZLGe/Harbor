    {
      "from": "PassageChoice",
      "to": "AidGranted",
      "text": "1. Accept the escort and terms."
    },
    {
      "from": "PassageChoice",
      "to": "FeeWaiver",
      "text": "2. Ask for a waived inspection fee."
    },
    {
      "from": "PassageChoice",
      "to": "NegotiationHub",
      "text": "3. Return to negotiations."
    },
    {
      "from": "FeeWaiver",
