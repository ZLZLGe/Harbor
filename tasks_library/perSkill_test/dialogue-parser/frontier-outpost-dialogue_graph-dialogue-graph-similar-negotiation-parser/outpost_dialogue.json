    },
    {
      "from": "CaravanChoice",
      "to": "MissingSeal",
      "text": "3. Admit the lead seal was broken in the storm."
    },
    {
      "from": "CaravanChoice",
      "to": "NegotiationHub",
      "text": "4. Return to a different offer."
