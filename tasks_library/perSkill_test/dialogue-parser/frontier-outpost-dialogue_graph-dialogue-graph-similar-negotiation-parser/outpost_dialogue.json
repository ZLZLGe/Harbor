    },
    {
      "from": "MissingSealChoice",
      "to": "BribeAttempt",
      "text": "2. [Bribe] Slide a heavy coin pouch across the table."
    },
    {
      "from": "MissingSealChoice",
      "to": "NegotiationHub",
      "text": "3. Retreat to another proposal."
    },
    {
      "from": "InspectionDelay",
      "to": "DelayChoice",
