digraph OutpostDialogue {
  rankdir=LR;
  End [shape=doublecircle, label="End"];
  "Start" [shape=box, label="Start"];
  "GateChallenge" [shape=box, label="GateChallenge"];
  "NegotiationHub" [shape=diamond, label="NegotiationHub"];
  "ScoutRead" [shape=box, label="ScoutRead"];
  "ScoutChoice" [shape=diamond, label="ScoutChoice"];
  "FatigueArgument" [shape=box, label="FatigueArgument"];
  "VulnerabilityHint" [shape=box, label="VulnerabilityHint"];
  "SuspicionChoice" [shape=diamond, label="SuspicionChoice"];
  "AdviceAccepted" [shape=box, label="AdviceAccepted"];
  "CaravanPitch" [shape=box, label="CaravanPitch"];
  "CaravanChoice" [shape=diamond, label="CaravanChoice"];
  "PapersShown" [shape=box, label="PapersShown"];
  "MercyAppeal" [shape=box, label="MercyAppeal"];
  "MissingSeal" [shape=box, label="MissingSeal"];
  "MissingSealChoice" [shape=diamond, label="MissingSealChoice"];
  "InspectionDelay" [shape=box, label="InspectionDelay"];
  "DelayChoice" [shape=diamond, label="DelayChoice"];
  "BribeAttempt" [shape=box, label="BribeAttempt"];
  "GuildThreat" [shape=box, label="GuildThreat"];
  "PassageTerms" [shape=box, label="PassageTerms"];
  "PassageChoice" [shape=diamond, label="PassageChoice"];
  "FeeWaiver" [shape=box, label="FeeWaiver"];
  "FeeWaiverChoice" [shape=diamond, label="FeeWaiverChoice"];
  "TreatyWin" [shape=box, label="TreatyWin"];
  "SaltBargain" [shape=box, label="SaltBargain"];
  "DelayedPassage" [shape=box, label="DelayedPassage"];
  "BitterPassage" [shape=diamond, label="BitterPassage"];
  "ContractPitch" [shape=box, label="ContractPitch"];
  "ContractChoice" [shape=diamond, label="ContractChoice"];
  "LedgerReview" [shape=box, label="LedgerReview"];
  "CharterClaim" [shape=box, label="CharterClaim"];
  "CharterProof" [shape=diamond, label="CharterProof"];
  "ThinClaim" [shape=box, label="ThinClaim"];
  "ContractBribe" [shape=box, label="ContractBribe"];
  "ContractTerms" [shape=box, label="ContractTerms"];
  "ContractDecision" [shape=diamond, label="ContractDecision"];
  "ExtendedDeadline" [shape=box, label="ExtendedDeadline"];
  "AidGranted" [shape=box, label="AidGranted"];
  "ContractSealed" [shape=box, label="ContractSealed"];
  "QuietRetreat" [shape=box, label="QuietRetreat"];
  "Detained" [shape=box, label="Detained"];
  "AlarmRaised" [shape=box, label="AlarmRaised"];
  "Start" -> "GateChallenge";
  "GateChallenge" -> "NegotiationHub";
  "NegotiationHub" -> "CaravanPitch" [label="1. Request emergency passage for a medical caravan."];
  "NegotiationHub" -> "ContractPitch" [label="2. Offer a salvage-and-supply contract."];
  "NegotiationHub" -> "ScoutRead" [label="3. [Observe] Study the sentries before speaking."];
  "NegotiationHub" -> "QuietRetreat" [label="4. Withdraw before the talks sour."];
  "ScoutRead" -> "ScoutChoice";
  "ScoutChoice" -> "FatigueArgument" [label="1. Mention the exhausted sentries to argue for urgency."];
  "ScoutChoice" -> "VulnerabilityHint" [label="2. Note the exposed horn and imply the outpost is vulnerable."];
  "ScoutChoice" -> "NegotiationHub" [label="3. Return to the main negotiation."];
  "FatigueArgument" -> "PassageTerms";
  "VulnerabilityHint" -> "SuspicionChoice";
  "SuspicionChoice" -> "AdviceAccepted" [label="1. Clarify that you are offering free advice."];
  "SuspicionChoice" -> "AlarmRaised" [label="2. Double down and threaten to spread the rumor."];
  "SuspicionChoice" -> "NegotiationHub" [label="3. Return to the main negotiation."];
  "AdviceAccepted" -> "NegotiationHub";
  "CaravanPitch" -> "CaravanChoice";
  "CaravanChoice" -> "PapersShown" [label="1. Present stamped manifests."];
  "CaravanChoice" -> "MercyAppeal" [label="2. [Persuade] Describe the fever spreading beyond the ridge."];
  "CaravanChoice" -> "MissingSeal" [label="3. Admit the lead seal was broken in the storm."];
  "CaravanChoice" -> "NegotiationHub" [label="4. Return to a different offer."];
  "PapersShown" -> "PassageTerms";
  "MercyAppeal" -> "PassageTerms";
  "MissingSeal" -> "MissingSealChoice";
  "MissingSealChoice" -> "InspectionDelay" [label="1. Offer to unload the wagons for inspection."];
  "MissingSealChoice" -> "BribeAttempt" [label="2. [Bribe] Slide a heavy coin pouch across the table."];
  "MissingSealChoice" -> "NegotiationHub" [label="3. Retreat to another proposal."];
  "InspectionDelay" -> "DelayChoice";
  "DelayChoice" -> "DelayedPassage" [label="1. Accept the inspection anyway."];
  "DelayChoice" -> "GuildThreat" [label="2. [Intimidate] Warn that the miners' guild will remember this."];
  "DelayChoice" -> "NegotiationHub" [label="3. Return to negotiations."];
  "BribeAttempt" -> "Detained";
  "GuildThreat" -> "Detained";
  "PassageTerms" -> "PassageChoice";
  "PassageChoice" -> "AidGranted" [label="1. Accept the escort and terms."];
  "PassageChoice" -> "FeeWaiver" [label="2. Ask for a waived inspection fee."];
  "PassageChoice" -> "NegotiationHub" [label="3. Return to negotiations."];
  "FeeWaiver" -> "FeeWaiverChoice";
  "FeeWaiverChoice" -> "TreatyWin" [label="1. [Recall] Cite the famine relief clause from the Red Basin treaty."];
  "FeeWaiverChoice" -> "SaltBargain" [label="2. Promise half your next caravan's salt ration."];
  "FeeWaiverChoice" -> "PassageTerms" [label="3. Drop the request."];
  "TreatyWin" -> "AidGranted";
  "SaltBargain" -> "AidGranted";
  "DelayedPassage" -> "BitterPassage";
  "BitterPassage" -> "End" [label="1. Count it as a partial success and move on."];
  "BitterPassage" -> "NegotiationHub" [label="2. Return tomorrow with a better offer."];
  "ContractPitch" -> "ContractChoice";
  "ContractChoice" -> "LedgerReview" [label="1. Present the salvage ledgers."];
  "ContractChoice" -> "CharterClaim" [label="2. [Recall] Cite the abandoned-fort recovery charter."];
  "ContractChoice" -> "ContractBribe" [label="3. [Bribe] Offer a private commission."];
  "ContractChoice" -> "NegotiationHub" [label="4. Return to the main negotiation."];
  "LedgerReview" -> "ContractTerms";
  "CharterClaim" -> "CharterProof";
  "CharterProof" -> "ContractTerms" [label="1. Produce the signed charter copy."];
  "CharterProof" -> "ThinClaim" [label="2. Admit you only memorized the title."];
  "ThinClaim" -> "NegotiationHub";
  "ContractBribe" -> "Detained";
  "ContractTerms" -> "ContractDecision";
  "ContractDecision" -> "ContractSealed" [label="1. Accept the timeline."];
  "ContractDecision" -> "ExtendedDeadline" [label="2. [Persuade] Ask for eight days because of the ice road."];
  "ContractDecision" -> "NegotiationHub" [label="3. Refuse and pivot back to passage talks."];
  "ExtendedDeadline" -> "ContractSealed";
  "AidGranted" -> "End";
  "ContractSealed" -> "End";
  "QuietRetreat" -> "End";
  "Detained" -> "End";
  "AlarmRaised" -> "End";
}
