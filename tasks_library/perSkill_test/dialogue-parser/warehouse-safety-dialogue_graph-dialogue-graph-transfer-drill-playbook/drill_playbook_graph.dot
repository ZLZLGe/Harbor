digraph DrillPlaybook {
  rankdir=TB;
  node [fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=8];
  "End" [label="END", shape=doublecircle, style=filled, fillcolor=lightgray];
  "DrillBriefing" [label="DrillBriefing\\nCoordinator: Morning drill begins with a staged report from the outbound warehouse floor.", shape=box, style="filled,rounded", fillcolor=white];
  "ReportIntake" [label="ReportIntake", shape=diamond, style=filled, fillcolor=lightblue];
  "SmokeObservation" [label="SmokeObservation\\nSpotter: The observer sees thin gray smoke drifting above the charging station.", shape=box, style="filled,rounded", fillcolor=white];
  "SmokeAssessment" [label="SmokeAssessment", shape=diamond, style=filled, fillcolor=lightblue];
  "SmokeSafePoint" [label="SmokeSafePoint\\nCoordinator: The observer is clear of the hazard and can continue reporting from a safe point.", shape=box, style="filled,rounded", fillcolor=white];
  "ShiftLeadNotice" [label="ShiftLeadNotice\\nShiftLead: The shift lead acknowledges the report and asks for a location update.", shape=box, style="filled,rounded", fillcolor=white];
  "FireTeamStandby" [label="FireTeamStandby\\nFireMarshal: The fire team stages outside the aisle and waits for severity classification.", shape=box, style="filled,rounded", fillcolor=white];
  "BatteryCheck" [label="BatteryCheck\\nSpotter: Two chargers are active and one bay shows a blinking fault light.", shape=box, style="filled,rounded", fillcolor=white];
  "SpillObservation" [label="SpillObservation\\nSpotter: A solvent drum is weeping under the lower rim and liquid is pooling toward the conveyor.", shape=box, style="filled,rounded", fillcolor=white];
  "SpillAssessment" [label="SpillAssessment", shape=diamond, style=filled, fillcolor=lightblue];
  "DrumLabelCheck" [label="DrumLabelCheck\\nCoordinator: The label confirms a flammable cleaning solvent with a low flash point.", shape=box, style="filled,rounded", fillcolor=white];
  "SpillContainment" [label="SpillContainment\\nSafetyLead: The absorbent barrier slows the spread and keeps liquid out of the walking lane.", shape=box, style="filled,rounded", fillcolor=white];
  "HazmatNotice" [label="HazmatNotice\\nHazmatDesk: The hazmat coordinator requests a severity rating before dispatching the spill team.", shape=box, style="filled,rounded", fillcolor=white];
  "ConveyorStop" [label="ConveyorStop\\nWarehouseOps: Packing lane two is paused so no cartons pass through the spill zone.", shape=box, style="filled,rounded", fillcolor=white];
  "RackObservation" [label="RackObservation\\nSpotter: A pallet on the fourth level is leaning forward and one beam looks twisted.", shape=box, style="filled,rounded", fillcolor=white];
  "RackAssessment" [label="RackAssessment", shape=diamond, style=filled, fillcolor=lightblue];
  "RackIsolation" [label="RackIsolation\\nSafetyLead: Tape and cones block the aisle so no picker enters the unstable bay.", shape=box, style="filled,rounded", fillcolor=white];
  "BeamInspection" [label="BeamInspection\\nCoordinator: The inspection finds scrape marks on the upright and one loose pallet board.", shape=box, style="filled,rounded", fillcolor=white];
  "MaintenanceNotice" [label="MaintenanceNotice\\nMaintenanceLead: Maintenance logs the rack location and waits for the triage result.", shape=box, style="filled,rounded", fillcolor=white];
  "OverflowRedirect" [label="OverflowRedirect\\nWarehouseOps: Pickers are reassigned to the overflow lane to keep the drill moving safely.", shape=box, style="filled,rounded", fillcolor=white];
  "InjuryObservation" [label="InjuryObservation\\nSpotter: A worker is seated on the floor after a shrink-wrap cart clipped the shin guard.", shape=box, style="filled,rounded", fillcolor=white];
  "InjuryAssessment" [label="InjuryAssessment", shape=diamond, style=filled, fillcolor=lightblue];
  "MedicNotice" [label="MedicNotice\\nMedicLead: The first-aid lead is en route and asks whether there is visible bleeding.", shape=box, style="filled,rounded", fillcolor=white];
  "ForkliftFreeze" [label="ForkliftFreeze\\nWarehouseOps: Nearby forklift traffic is frozen and the crossing lane is held clear.", shape=box, style="filled,rounded", fillcolor=white];
  "WitnessNotes" [label="WitnessNotes\\nCoordinator: Two witnesses confirm the cart entered the crossing before the spotter called stop.", shape=box, style="filled,rounded", fillcolor=white];
  "MobilityCheck" [label="MobilityCheck\\nSpotter: The worker can stand with assistance but reports sharp pain when turning.", shape=box, style="filled,rounded", fillcolor=white];
  "AlarmObservation" [label="AlarmObservation\\nControlRoom: The strobe and siren are active, but the camera feed shows no obvious smoke or spill.", shape=box, style="filled,rounded", fillcolor=white];
  "AlarmAssessment" [label="AlarmAssessment", shape=diamond, style=filled, fillcolor=lightblue];
  "ResetLogCheck" [label="ResetLogCheck\\nCoordinator: The last reset happened during battery maintenance one hour ago.", shape=box, style="filled,rounded", fillcolor=white];
  "ControlRoomNotice" [label="ControlRoomNotice\\nControlRoom: The panel points to a detector above the charging cages and no other zones are active.", shape=box, style="filled,rounded", fillcolor=white];
  "HeatSourceSweep" [label="HeatSourceSweep\\nSpotter: The sweep finds a warm charger housing that may explain the alarm.", shape=box, style="filled,rounded", fillcolor=white];
  "FalseAlarmPrep" [label="FalseAlarmPrep\\nCoordinator: A draft closeout form is opened in case the drill is ruled a false alarm.", shape=box, style="filled,rounded", fillcolor=white];
  "ReportReview" [label="ReportReview\\nCoordinator: The observation report now includes location, people affected, active controls, and reporting notes.", shape=box, style="filled,rounded", fillcolor=white];
  "SeverityTriage" [label="SeverityTriage", shape=diamond, style=filled, fillcolor=lightblue];
  "LowResponse" [label="LowResponse\\nSafetyLead: Low-impact events stay local, but the team still has to assign a documented control.", shape=box, style="filled,rounded", fillcolor=white];
  "LowActionChoice" [label="LowActionChoice", shape=diamond, style=filled, fillcolor=lightblue];
  "SpotterPosted" [label="SpotterPosted\\nSafetyLead: A spotter remains in place and logs every movement through the zone.", shape=box, style="filled,rounded", fillcolor=white];
  "LanePause" [label="LanePause\\nWarehouseOps: Only the affected lane is paused while neighboring work continues under watch.", shape=box, style="filled,rounded", fillcolor=white];
  "LimitedResponse" [label="LimitedResponse\\nOpsLead: Limited-area events require a perimeter, an operations hold, and recovery planning.", shape=box, style="filled,rounded", fillcolor=white];
  "LimitedActionChoice" [label="LimitedActionChoice", shape=diamond, style=filled, fillcolor=lightblue];
  "PerimeterExpand" [label="PerimeterExpand\\nOpsLead: The perimeter now covers the aisle, the adjacent dock door, and the cross-lane walkway.", shape=box, style="filled,rounded", fillcolor=white];
  "InventoryHold" [label="InventoryHold\\nInventoryControl: Outgoing pallets from the affected zone are marked on hold in the queue.", shape=box, style="filled,rounded", fillcolor=white];
  "VendorStandby" [label="VendorStandby\\nOpsLead: A vendor call tree is opened, but dispatch waits for the final recovery decision.", shape=box, style="filled,rounded", fillcolor=white];
  "SiteLeadEscalation" [label="SiteLeadEscalation\\nSiteLead: Site-level emergencies shift to incident command and coordinated notifications.", shape=box, style="filled,rounded", fillcolor=white];
  "EmergencyActionChoice" [label="EmergencyActionChoice", shape=diamond, style=filled, fillcolor=lightblue];
  "EmergencyDispatch" [label="EmergencyDispatch\\nSiteLead: Emergency services are notified in the drill timeline and staging instructions are announced.", shape=box, style="filled,rounded", fillcolor=white];
  "BayEvacuation" [label="BayEvacuation\\nSecurityDesk: Bays one through four are cleared and dock traffic is rerouted to the north apron.", shape=box, style="filled,rounded", fillcolor=white];
  "CommandBridge" [label="CommandBridge\\nControlRoom: The radio bridge opens for site lead, safety, security, and floor operations.", shape=box, style="filled,rounded", fillcolor=white];
  "FalseAlarmReview" [label="FalseAlarmReview\\nCoordinator: False-alarm cases still need documentation before operations can fully reopen.", shape=box, style="filled,rounded", fillcolor=white];
  "FalseAlarmChoice" [label="FalseAlarmChoice", shape=diamond, style=filled, fillcolor=lightblue];
  "DetectorReset" [label="DetectorReset\\nControlRoom: The detector is reset and a watch period begins for the charging zone.", shape=box, style="filled,rounded", fillcolor=white];
  "PanelTicketClose" [label="PanelTicketClose\\nControlRoom: The alarm ticket is closed with drill annotations and the trigger source.", shape=box, style="filled,rounded", fillcolor=white];
  "FalseAlarmDocumentation" [label="FalseAlarmDocumentation\\nCoordinator: The false-alarm packet is complete and no active hazard remains on the floor.", shape=box, style="filled,rounded", fillcolor=white];
  "FalseAlarmClosed" [label="FalseAlarmClosed\\nCoordinator: The drill closes as a documented false alarm and normal work can continue.", shape=box, style="filled,rounded", fillcolor=white];
  "CleanupPlanning" [label="CleanupPlanning\\nSafetyLead: Cleanup and recovery tasks are assigned before any restart decision is approved.", shape=box, style="filled,rounded", fillcolor=white];
  "NotificationMatrix" [label="NotificationMatrix", shape=diamond, style=filled, fillcolor=lightblue];
  "OpsBroadcast" [label="OpsBroadcast\\nWarehouseOps: Floor leads receive the restart estimate and revised work assignments.", shape=box, style="filled,rounded", fillcolor=white];
  "HRTrainingNotice" [label="HRTrainingNotice\\nHRDesk: HR logs the drill timing and any injury simulation notes for training records.", shape=box, style="filled,rounded", fillcolor=white];
  "LeadershipSummary" [label="LeadershipSummary\\nSiteLead: Leadership receives the severity summary, control actions, and recovery timing.", shape=box, style="filled,rounded", fillcolor=white];
  "SecurityNotice" [label="SecurityNotice\\nSecurityDesk: Security confirms dock doors and pedestrian gates remain under the drill perimeter rules.", shape=box, style="filled,rounded", fillcolor=white];
  "RecoveryChecklist" [label="RecoveryChecklist\\nCoordinator: The recovery checklist tracks cleanup, briefing, and restart prerequisites.", shape=box, style="filled,rounded", fillcolor=white];
  "RecoveryChoice" [label="RecoveryChoice", shape=diamond, style=filled, fillcolor=lightblue];
  "AreaVerified" [label="AreaVerified\\nOpsLead: The area is clean, tagged, and ready for restart authorization.", shape=box, style="filled,rounded", fillcolor=white];
  "StaffBriefed" [label="StaffBriefed\\nSafetyLead: Team members sign the post-drill briefing sheet and acknowledge next steps.", shape=box, style="filled,rounded", fillcolor=white];
  "DebriefMeeting" [label="DebriefMeeting\\nCoordinator: Lessons learned are logged and action items are assigned to named owners.", shape=box, style="filled,rounded", fillcolor=white];
  "InvestigationReview" [label="InvestigationReview\\nSiteLead: Open questions remain, so the drill is handed to the investigation queue.", shape=box, style="filled,rounded", fillcolor=white];
  "InvestigationClosed" [label="InvestigationClosed\\nSiteLead: The event remains closed for operations until the investigation report is reviewed.", shape=box, style="filled,rounded", fillcolor=white];
  "RestartDecision" [label="RestartDecision", shape=diamond, style=filled, fillcolor=lightblue];
  "DrillComplete" [label="DrillComplete\\nCoordinator: The drill is complete and the warehouse returns to standard monitoring.", shape=box, style="filled,rounded", fillcolor=white];
  "OperationsResume" [label="OperationsResume\\nOpsLead: Normal picking waves resume with spot checks for the next shift.", shape=box, style="filled,rounded", fillcolor=white];
  "PartialResume" [label="PartialResume\\nOpsLead: Manual packing restarts first while the affected equipment remains locked out.", shape=box, style="filled,rounded", fillcolor=white];
  "DrillBriefing" -> "ReportIntake";
  "ReportIntake" -> "SmokeObservation" [label="1. [Observe: Smoke] Report light haze near the battery charging cages."];
  "ReportIntake" -> "SpillObservation" [label="2. [Observe: Spill] Report a leaking solvent drum beside packing lane two."];
  "ReportIntake" -> "RackObservation" [label="3. [Observe: Rack] Report a leaning pallet stack in high-bay storage."];
  "ReportIntake" -> "InjuryObservation" [label="4. [Observe: Injury] Report a worker clipped by a shrink-wrap cart."];
  "ReportIntake" -> "AlarmObservation" [label="5. [Observe: Alarm] Report a flashing siren without an obvious hazard."];
  "SmokeObservation" -> "SmokeAssessment";
  "SmokeAssessment" -> "SmokeSafePoint" [label="1. Move the observer to a safe point near the fire cabinet."];
  "SmokeAssessment" -> "ShiftLeadNotice" [label="2. [Notify: Shift Lead] Call the shift lead to bay three."];
  "SmokeAssessment" -> "FireTeamStandby" [label="3. [Escalate: Fire Team] Request extinguisher team standby."];
  "SmokeAssessment" -> "BatteryCheck" [label="4. Check whether batteries are currently charging."];
  "SmokeSafePoint" -> "ReportReview";
  "ShiftLeadNotice" -> "ReportReview";
  "FireTeamStandby" -> "SeverityTriage";
  "BatteryCheck" -> "ReportReview";
  "SpillObservation" -> "SpillAssessment";
  "SpillAssessment" -> "DrumLabelCheck" [label="1. Read the drum label before anyone moves it."];
  "SpillAssessment" -> "SpillContainment" [label="2. Deploy absorbent socks around the pooling liquid."];
  "SpillAssessment" -> "HazmatNotice" [label="3. [Notify: Hazmat Coordinator] Call the hazmat desk for guidance."];
  "SpillAssessment" -> "ConveyorStop" [label="4. Stop the conveyor on packing lane two."];
  "DrumLabelCheck" -> "ReportReview";
  "SpillContainment" -> "ReportReview";
  "HazmatNotice" -> "SeverityTriage";
  "ConveyorStop" -> "ReportReview";
  "RackObservation" -> "RackAssessment";
  "RackAssessment" -> "RackIsolation" [label="1. Cordon the rack aisle immediately."];
  "RackAssessment" -> "BeamInspection" [label="2. Inspect nearby beams for bend marks."];
  "RackAssessment" -> "MaintenanceNotice" [label="3. [Notify: Maintenance] Request a structural check from maintenance."];
  "RackAssessment" -> "OverflowRedirect" [label="4. Move nearby pickers to the overflow lane."];
  "RackIsolation" -> "ReportReview";
  "BeamInspection" -> "ReportReview";
  "MaintenanceNotice" -> "ReportReview";
  "OverflowRedirect" -> "ReportReview";
  "InjuryObservation" -> "InjuryAssessment";
  "InjuryAssessment" -> "MedicNotice" [label="1. [Notify: Medic] Call the first-aid lead to the scene."];
  "InjuryAssessment" -> "ForkliftFreeze" [label="2. Freeze nearby forklift traffic."];
  "InjuryAssessment" -> "WitnessNotes" [label="3. Record witness statements while the lane is quiet."];
  "InjuryAssessment" -> "MobilityCheck" [label="4. Check whether the worker can walk without support."];
  "MedicNotice" -> "SeverityTriage";
  "ForkliftFreeze" -> "ReportReview";
  "WitnessNotes" -> "ReportReview";
  "MobilityCheck" -> "ReportReview";
  "AlarmObservation" -> "AlarmAssessment";
  "AlarmAssessment" -> "ResetLogCheck" [label="1. Check the last detector reset log."];
  "AlarmAssessment" -> "ControlRoomNotice" [label="2. [Notify: Control Room] Confirm which panel triggered the alarm."];
  "AlarmAssessment" -> "HeatSourceSweep" [label="3. Sweep the zone for a hidden heat source."];
  "AlarmAssessment" -> "FalseAlarmPrep" [label="4. Prepare a false-alarm closeout packet."];
  "ResetLogCheck" -> "ReportReview";
  "ControlRoomNotice" -> "ReportReview";
  "HeatSourceSweep" -> "SeverityTriage";
  "FalseAlarmPrep" -> "ReportReview";
  "ReportReview" -> "SeverityTriage";
  "SeverityTriage" -> "LowResponse" [label="1. Classify the inject as low impact."];
  "SeverityTriage" -> "LimitedResponse" [label="2. Classify the event as limited-area disruption."];
  "SeverityTriage" -> "SiteLeadEscalation" [label="3. [Escalate: Site Lead] Classify the event as a site-level emergency."];
  "SeverityTriage" -> "FalseAlarmReview" [label="4. Classify the event as a likely false alarm."];
  "LowResponse" -> "LowActionChoice";
  "LowActionChoice" -> "SpotterPosted" [label="1. Keep the zone open with a spotter posted."];
  "LowActionChoice" -> "LanePause" [label="2. Pause only the affected lane while checks finish."];
  "LowActionChoice" -> "CleanupPlanning" [label="3. Route the low-severity case into cleanup planning."];
  "SpotterPosted" -> "CleanupPlanning";
  "LanePause" -> "CleanupPlanning";
  "LimitedResponse" -> "LimitedActionChoice";
  "LimitedActionChoice" -> "PerimeterExpand" [label="1. Expand the perimeter and halt local picking."];
  "LimitedActionChoice" -> "InventoryHold" [label="2. [Notify: Inventory Control] Hold outgoing pallets from the zone."];
  "LimitedActionChoice" -> "VendorStandby" [label="3. Prepare external vendor support if the condition worsens."];
  "LimitedActionChoice" -> "CleanupPlanning" [label="4. Route the limited-area case into cleanup planning."];
  "PerimeterExpand" -> "CleanupPlanning";
  "InventoryHold" -> "CleanupPlanning";
  "VendorStandby" -> "CleanupPlanning";
  "SiteLeadEscalation" -> "EmergencyActionChoice";
  "EmergencyActionChoice" -> "EmergencyDispatch" [label="1. [Escalate: 911] Simulate emergency services notification."];
  "EmergencyActionChoice" -> "BayEvacuation" [label="2. Order full evacuation of bays one through four."];
  "EmergencyActionChoice" -> "CommandBridge" [label="3. Activate the incident command radio bridge."];
  "EmergencyActionChoice" -> "CleanupPlanning" [label="4. Route the site-level case into cleanup planning."];
  "EmergencyDispatch" -> "CleanupPlanning";
  "BayEvacuation" -> "CleanupPlanning";
  "CommandBridge" -> "CleanupPlanning";
  "FalseAlarmReview" -> "FalseAlarmChoice";
  "FalseAlarmChoice" -> "DetectorReset" [label="1. Reset the detector and document the cause."];
  "FalseAlarmChoice" -> "PanelTicketClose" [label="2. [Notify: Control Room] Close the alarm ticket with drill notes."];
  "FalseAlarmChoice" -> "FalseAlarmClosed" [label="3. Reopen operations after a final sweep."];
  "FalseAlarmChoice" -> "CleanupPlanning" [label="4. Route the false-alarm case into cleanup planning."];
  "DetectorReset" -> "FalseAlarmDocumentation";
  "PanelTicketClose" -> "FalseAlarmDocumentation";
  "FalseAlarmDocumentation" -> "FalseAlarmClosed";
  "FalseAlarmClosed" -> "End";
  "CleanupPlanning" -> "NotificationMatrix";
  "NotificationMatrix" -> "OpsBroadcast" [label="1. [Notify: Warehouse Ops] Send the restart estimate to floor leads."];
  "NotificationMatrix" -> "HRTrainingNotice" [label="2. [Notify: HR] Log injury and drill timing details for training review."];
  "NotificationMatrix" -> "LeadershipSummary" [label="3. [Notify: Site Lead] Send the severity summary to leadership."];
  "NotificationMatrix" -> "SecurityNotice" [label="4. [Notify: Security Desk] Confirm dock doors remain controlled."];
  "NotificationMatrix" -> "RecoveryChecklist" [label="5. Move directly to the recovery checklist."];
  "OpsBroadcast" -> "RecoveryChecklist";
  "HRTrainingNotice" -> "RecoveryChecklist";
  "LeadershipSummary" -> "RecoveryChecklist";
  "SecurityNotice" -> "RecoveryChecklist";
  "RecoveryChecklist" -> "RecoveryChoice";
  "RecoveryChoice" -> "AreaVerified" [label="1. Verify the area is clean and equipment is tagged."];
  "RecoveryChoice" -> "StaffBriefed" [label="2. Confirm the staff briefing is complete."];
  "RecoveryChoice" -> "DebriefMeeting" [label="3. [Wrap-Up] Hold the final debrief before restart."];
  "RecoveryChoice" -> "InvestigationReview" [label="4. [Wrap-Up] Escalate unresolved issues to investigation."];
  "AreaVerified" -> "RestartDecision";
  "StaffBriefed" -> "RestartDecision";
  "DebriefMeeting" -> "DrillComplete";
  "InvestigationReview" -> "InvestigationClosed";
  "InvestigationClosed" -> "End";
  "RestartDecision" -> "OperationsResume" [label="1. Resume normal picking waves."];
  "RestartDecision" -> "PartialResume" [label="2. Reopen only manual packing stations."];
  "RestartDecision" -> "InvestigationReview" [label="3. Keep the zone closed pending investigation."];
  "DrillComplete" -> "End";
  "OperationsResume" -> "End";
  "PartialResume" -> "End";
}
