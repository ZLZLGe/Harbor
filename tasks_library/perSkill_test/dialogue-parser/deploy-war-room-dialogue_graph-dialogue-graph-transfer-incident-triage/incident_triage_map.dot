digraph DialogueGraph {
  rankdir="TB";
  splines="ortho";
  nodesep="0.5";
  ranksep="0.8";
  node [fontname="Arial" fontsize="10"];
  edge [fontname="Arial" fontsize="8"];
  "End" [label="END" shape="doublecircle" style="filled" fillcolor="lightgray" width="0.8"];
  "AlertIngress" [label="AlertIngress\\nMonitor: PagerDuty reports elevated 5xx after the 09:40 deploy wave." shape="box" style="filled,rounded" fillcolor="lightyellow" width="2"];
  "SeverityGate" [label="SeverityGate" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "SevOneBridge" [label="SevOneBridge\\nIncidentLead: Open the release war room, assign an incident scribe, and confirm customer impact within five minutes." shape="box" style="filled,rounded" fillcolor="mistyrose" width="2"];
  "BlastRadiusChoice" [label="BlastRadiusChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "RollbackPrep" [label="RollbackPrep\\nReleaseEngineer: Compare the failing build to the last healthy release and confirm which switch is safest to reverse first." shape="box" style="filled,rounded" fillcolor="lightcyan" width="2"];
  "RollbackChoice" [label="RollbackChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "FlagDisable" [label="FlagDisable\\nReleaseEngineer: The feature flag is disabled and the newest requests are draining through the old path." shape="box" style="filled,rounded" fillcolor="lightcyan" width="2"];
  "RollbackExecute" [label="RollbackExecute\\nReleaseEngineer: The previous release is redeploying across the production cluster now." shape="box" style="filled,rounded" fillcolor="lightcyan" width="2"];
  "DatabaseCheck" [label="DatabaseCheck\\nDatabase: I am checking replica lag, lock contention, and whether the new schema can safely move backward." shape="box" style="filled,rounded" fillcolor="lavender" width="2"];
  "DatabaseChoice" [label="DatabaseChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "FailoverStep" [label="FailoverStep\\nDatabase: Promote the healthy replica, pin writes there, and let the old primary cool down." shape="box" style="filled,rounded" fillcolor="lavender" width="2"];
  "StatusDraft" [label="StatusDraft\\nComms: I have a draft customer update and can publish it as soon as we agree on scope and wording." shape="box" style="filled,rounded" fillcolor="peachpuff" width="2"];
  "StatusChoice" [label="StatusChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "DependencyCheck" [label="DependencyCheck\\nSRE: Compare trace spans, dependency dashboards, and deploy timing to find out whether the fault sits outside the application pods." shape="box" style="filled,rounded" fillcolor="honeydew" width="2"];
  "DependencyChoice" [label="DependencyChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "VendorBridge" [label="VendorBridge\\nSRE: The vendor bridge is open, and their engineer wants either degraded mode or a five-minute observation window." shape="box" style="filled,rounded" fillcolor="honeydew" width="2"];
  "VendorChoice" [label="VendorChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "DegradedMode" [label="DegradedMode\\nSRE: Degraded mode is on, error volume has dropped, and we can check whether the customer-facing path is stable enough to hold." shape="box" style="filled,rounded" fillcolor="honeydew" width="2"];
  "CacheMitigation" [label="CacheMitigation\\nSRE: Flush the stale cache tier, reload configuration, and watch whether the failing requests clear." shape="box" style="filled,rounded" fillcolor="honeydew" width="2"];
  "EdgeBalancerCheck" [label="EdgeBalancerCheck\\nEdgeTeam: One region is receiving a bad slice of traffic while the rest of the edge looks healthy." shape="box" style="filled,rounded" fillcolor="aliceblue" width="2"];
  "EdgeChoice" [label="EdgeChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "ZoneDrain" [label="ZoneDrain\\nEdgeTeam: The unhealthy zone is drained and user traffic has shifted to the remaining regions." shape="box" style="filled,rounded" fillcolor="aliceblue" width="2"];
  "RoutingRevert" [label="RoutingRevert\\nEdgeTeam: Canary routing weights are back to the pre-deploy split." shape="box" style="filled,rounded" fillcolor="aliceblue" width="2"];
  "PlatformEscalation" [label="PlatformEscalation\\nIncidentLead: Platform engineering is taking over the live mitigation while we preserve notes and customer timelines." shape="box" style="filled,rounded" fillcolor="mistyrose" width="2"];
  "SevTwoAssess" [label="SevTwoAssess\\nIncidentLead: Keep the release bridge small, assign one owner per hypothesis, and confirm whether the incident is user-visible before escalating." shape="box" style="filled,rounded" fillcolor="mistyrose" width="2"];
  "ServiceCheckChoice" [label="ServiceCheckChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "ServiceOwnerCheck" [label="ServiceOwnerCheck\\nServiceOwner: I checked the newest pods, recent endpoint changes, and the top failing requests in the service logs." shape="box" style="filled,rounded" fillcolor="azure" width="2"];
  "ServiceOwnerChoice" [label="ServiceOwnerChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "RestartPods" [label="RestartPods\\nServiceOwner: The newest pods are restarting, and the previous replicas are still serving traffic." shape="box" style="filled,rounded" fillcolor="azure" width="2"];
  "CapacityPlan" [label="CapacityPlan\\nSRE: Queue depth and worker saturation are the clearest signals, so capacity relief is the fastest next move." shape="box" style="filled,rounded" fillcolor="honeydew" width="2"];
  "CapacityChoice" [label="CapacityChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "ScaleOut" [label="ScaleOut\\nSRE: Extra capacity is online and the backlog is shrinking." shape="box" style="filled,rounded" fillcolor="honeydew" width="2"];
  "QueueDrain" [label="QueueDrain\\nSRE: Noncritical jobs are paused, the backlog is draining, and the hot path has more headroom." shape="box" style="filled,rounded" fillcolor="honeydew" width="2"];
  "SlowBurnDecision" [label="SlowBurnDecision\\nSupportLead: Customer reports are sparse, but the error budget is burning steadily enough that we may still need to widen the response." shape="box" style="filled,rounded" fillcolor="mintcream" width="2"];
  "SlowBurnChoice" [label="SlowBurnChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "WatchWindow" [label="WatchWindow\\nMonitor: Hold a ten-minute watch window and compare live traffic, error budget burn, and support chatter before changing mitigation." shape="box" style="filled,rounded" fillcolor="lightyellow" width="2"];
  "WatchChoice" [label="WatchChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "MonitorNoiseReview" [label="MonitorNoiseReview\\nObservability: Check whether the alert came from a synthetic probe, a silenced canary, or a query that changed labels during the deploy." shape="box" style="filled,rounded" fillcolor="lightgoldenrod1" width="2"];
  "NoiseChoice" [label="NoiseChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "QueryFix" [label="QueryFix\\nObservability: The alert rule is corrected and historical data confirms that production traffic stayed healthy." shape="box" style="filled,rounded" fillcolor="lightgoldenrod1" width="2"];
  "StabilizationReview" [label="StabilizationReview\\nIncidentLead: Re-check the core user journey, watch the main dashboards for fifteen minutes, and decide whether the incident is stable enough to close." shape="box" style="filled,rounded" fillcolor="mistyrose" width="2"];
  "StabilizationChoice" [label="StabilizationChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "BridgeRecheck" [label="BridgeRecheck\\nIncidentLead: Choose the next review loop based on which hypothesis is still alive after the latest mitigation." shape="box" style="filled,rounded" fillcolor="mistyrose" width="2"];
  "BridgeChoice" [label="BridgeChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "RecoverySummary" [label="RecoverySummary\\nComms: The incident looks stable, so choose the summary that best matches the mitigation we used and close the loop cleanly." shape="box" style="filled,rounded" fillcolor="peachpuff" width="2"];
  "RecoveryChoice" [label="RecoveryChoice" shape="diamond" style="filled" fillcolor="lightblue" width="1.5"];
  "FalseAlarmClosed" [label="FalseAlarmClosed\\nObservability: Close the incident as monitor noise or a self-recovered alert, and attach the query notes for follow-up tuning." shape="box" style="filled,rounded" fillcolor="lightgoldenrod1" width="2"];
  "RollbackComplete" [label="RollbackComplete\\nComms: Rollback recovery confirmed, customer traffic is healthy, and the release can stay frozen pending review." shape="box" style="filled,rounded" fillcolor="peachpuff" width="2"];
  "CapacityRecovered" [label="CapacityRecovered\\nIncidentLead: Capacity mitigation held through the watch window, so we can close and schedule scaling follow-up." shape="box" style="filled,rounded" fillcolor="mistyrose" width="2"];
  "DependencyMitigated" [label="DependencyMitigated\\nSRE: Dependency mitigation is holding, with degraded mode or routing changes documented for the next review." shape="box" style="filled,rounded" fillcolor="honeydew" width="2"];
  "FeatureFlagRecovered" [label="FeatureFlagRecovered\\nReleaseEngineer: The feature flag rollback restored stability, and the launch stays disabled until the fix is ready." shape="box" style="filled,rounded" fillcolor="lightcyan" width="2"];
  "ManualMitigationHandoff" [label="ManualMitigationHandoff\\nIncidentLead: Hand off the active mitigation to the next team with timeline, open hypotheses, and customer impact notes attached." shape="box" style="filled,rounded" fillcolor="mistyrose" width="2"];
  "AlertIngress" -> "SeverityGate" [color="black"];
  "SeverityGate" -> "SevOneBridge" [label="1. [SEV-1] Error rate is above 20% or checkout is fully down." color="darkblue" fontcolor="darkblue" style="bold"];
  "SeverityGate" -> "SevTwoAssess" [label="2. Error rate is elevated but core transactions still succeed." color="gray40" fontcolor="gray40"];
  "SeverityGate" -> "MonitorNoiseReview" [label="3. Alert appears noisy or is already recovering." color="gray40" fontcolor="gray40"];
  "SevOneBridge" -> "BlastRadiusChoice" [color="black"];
  "BlastRadiusChoice" -> "RollbackPrep" [label="1. [Rollback] Symptoms started immediately after the latest deploy." color="darkblue" fontcolor="darkblue" style="bold"];
  "BlastRadiusChoice" -> "DependencyCheck" [label="2. [Dependency] Traces point to a gateway, cache, or database dependency." color="darkblue" fontcolor="darkblue" style="bold"];
  "BlastRadiusChoice" -> "StatusDraft" [label="3. [Comms] Support volume is spiking and a status update may be needed." color="darkblue" fontcolor="darkblue" style="bold"];
  "RollbackPrep" -> "RollbackChoice" [color="black"];
  "RollbackChoice" -> "FlagDisable" [label="1. [Feature Flag] Disable the new feature flag before touching the build." color="darkblue" fontcolor="darkblue" style="bold"];
  "RollbackChoice" -> "RollbackExecute" [label="2. Start a full application rollback." color="gray40" fontcolor="gray40"];
  "RollbackChoice" -> "DatabaseCheck" [label="3. Ask the database owner whether schema changes block a rollback." color="gray40" fontcolor="gray40"];
  "FlagDisable" -> "StabilizationReview" [color="black"];
  "RollbackExecute" -> "StabilizationReview" [color="black"];
  "DatabaseCheck" -> "DatabaseChoice" [color="black"];
  "DatabaseChoice" -> "FailoverStep" [label="1. [DB Failover] Lag or lock contention is severe enough to move traffic." color="darkblue" fontcolor="darkblue" style="bold"];
  "DatabaseChoice" -> "RollbackExecute" [label="2. The schema is backward-compatible, so application rollback is safe." color="gray40" fontcolor="gray40"];
  "DatabaseChoice" -> "ManualMitigationHandoff" [label="3. We need a specialist on the bridge before changing anything." color="gray40" fontcolor="gray40"];
  "FailoverStep" -> "StabilizationReview" [color="black"];
  "StatusDraft" -> "StatusChoice" [color="black"];
  "StatusChoice" -> "DependencyCheck" [label="1. Publish the customer-facing note and continue dependency triage." color="gray40" fontcolor="gray40"];
  "StatusChoice" -> "RollbackPrep" [label="2. Send an internal-only heads-up and continue rollback preparation." color="gray40" fontcolor="gray40"];
  "StatusChoice" -> "StabilizationReview" [label="3. Metrics are already improving, so defer the update and re-check stability." color="gray40" fontcolor="gray40"];
  "DependencyCheck" -> "DependencyChoice" [color="black"];
  "DependencyChoice" -> "VendorBridge" [label="1. [Vendor Escalation] A third-party API latency spike dominates the traces." color="darkblue" fontcolor="darkblue" style="bold"];
  "DependencyChoice" -> "CacheMitigation" [label="2. [Cache Flush] Stale configuration or cache data is serving bad responses." color="darkblue" fontcolor="darkblue" style="bold"];
  "DependencyChoice" -> "EdgeBalancerCheck" [label="3. Edge traffic shifted unevenly after the deploy." color="gray40" fontcolor="gray40"];
  "DependencyChoice" -> "RollbackPrep" [label="4. No external signal stands out, return to the rollback path." color="gray40" fontcolor="gray40"];
  "VendorBridge" -> "VendorChoice" [color="black"];
  "VendorChoice" -> "DegradedMode" [label="1. Enable degraded mode while the vendor works the incident." color="gray40" fontcolor="gray40"];
  "VendorChoice" -> "DependencyCheck" [label="2. Wait five minutes and then repeat dependency checks." color="gray40" fontcolor="gray40"];
  "DegradedMode" -> "StabilizationReview" [color="black"];
  "CacheMitigation" -> "StabilizationReview" [color="black"];
  "EdgeBalancerCheck" -> "EdgeChoice" [color="black"];
  "EdgeChoice" -> "ZoneDrain" [label="1. Drain the unhealthy zone and keep the remaining regions serving traffic." color="gray40" fontcolor="gray40"];
  "EdgeChoice" -> "RoutingRevert" [label="2. Revert the canary routing weights to the previous distribution." color="gray40" fontcolor="gray40"];
  "EdgeChoice" -> "PlatformEscalation" [label="3. Escalate the imbalance to the platform war room." color="gray40" fontcolor="gray40"];
  "ZoneDrain" -> "StabilizationReview" [color="black"];
  "RoutingRevert" -> "StabilizationReview" [color="black"];
  "PlatformEscalation" -> "ManualMitigationHandoff" [color="black"];
  "SevTwoAssess" -> "ServiceCheckChoice" [color="black"];
  "ServiceCheckChoice" -> "ServiceOwnerCheck" [label="1. [Logs] Errors cluster around one service or endpoint." color="darkblue" fontcolor="darkblue" style="bold"];
  "ServiceCheckChoice" -> "CapacityPlan" [label="2. [Capacity] CPU, memory, or queue depth spiked after rollout." color="darkblue" fontcolor="darkblue" style="bold"];
  "ServiceCheckChoice" -> "SlowBurnDecision" [label="3. The issue is quiet for customers but persistent in alerts." color="gray40" fontcolor="gray40"];
  "ServiceOwnerCheck" -> "ServiceOwnerChoice" [color="black"];
  "ServiceOwnerChoice" -> "RestartPods" [label="1. Restart only the newest pods and keep the rest of the deployment." color="gray40" fontcolor="gray40"];
  "ServiceOwnerChoice" -> "FlagDisable" [label="2. Disable the new endpoint behind a feature flag." color="gray40" fontcolor="gray40"];
  "ServiceOwnerChoice" -> "SevOneBridge" [label="3. Escalate this to the SEV-1 bridge now." color="gray40" fontcolor="gray40"];
  "RestartPods" -> "StabilizationReview" [color="black"];
  "CapacityPlan" -> "CapacityChoice" [color="black"];
  "CapacityChoice" -> "ScaleOut" [label="1. Scale out the workers and web pods." color="gray40" fontcolor="gray40"];
  "CapacityChoice" -> "QueueDrain" [label="2. [Queue Drain] Pause noncritical jobs and drain the backlog first." color="darkblue" fontcolor="darkblue" style="bold"];
  "CapacityChoice" -> "DependencyCheck" [label="3. Capacity looks secondary, so inspect dependencies instead." color="gray40" fontcolor="gray40"];
  "ScaleOut" -> "StabilizationReview" [color="black"];
  "QueueDrain" -> "StabilizationReview" [color="black"];
  "SlowBurnDecision" -> "SlowBurnChoice" [color="black"];
  "SlowBurnChoice" -> "WatchWindow" [label="1. Draft an internal advisory and keep watching the metrics." color="gray40" fontcolor="gray40"];
  "SlowBurnChoice" -> "SevOneBridge" [label="2. Escalate to SEV-1 because the burn rate is accelerating." color="gray40" fontcolor="gray40"];
  "SlowBurnChoice" -> "MonitorNoiseReview" [label="3. Verify whether this is only monitor noise." color="gray40" fontcolor="gray40"];
  "WatchWindow" -> "WatchChoice" [color="black"];
  "WatchChoice" -> "FalseAlarmClosed" [label="1. Metrics recover during the watch window without another action." color="gray40" fontcolor="gray40"];
  "WatchChoice" -> "SevOneBridge" [label="2. Metrics worsen and customer errors start climbing fast." color="gray40" fontcolor="gray40"];
  "WatchChoice" -> "ServiceOwnerCheck" [label="3. One service keeps failing, so continue service-level checks." color="gray40" fontcolor="gray40"];
  "MonitorNoiseReview" -> "NoiseChoice" [color="black"];
  "NoiseChoice" -> "FalseAlarmClosed" [label="1. The alert only fired from a synthetic probe or silenced canary." color="gray40" fontcolor="gray40"];
  "NoiseChoice" -> "QueryFix" [label="2. The alert query is wrong after a label or dashboard change." color="gray40" fontcolor="gray40"];
  "NoiseChoice" -> "SevTwoAssess" [label="3. We still see uncertain impact, so return to SEV-2 assessment." color="gray40" fontcolor="gray40"];
  "QueryFix" -> "FalseAlarmClosed" [color="black"];
  "StabilizationReview" -> "StabilizationChoice" [color="black"];
  "StabilizationChoice" -> "RecoverySummary" [label="1. Metrics are back to baseline and the user journey is healthy." color="gray40" fontcolor="gray40"];
  "StabilizationChoice" -> "BridgeRecheck" [label="2. Error rate improved but is not stable enough yet." color="gray40" fontcolor="gray40"];
  "StabilizationChoice" -> "SevOneBridge" [label="3. A second region or service is now impacted." color="gray40" fontcolor="gray40"];
  "BridgeRecheck" -> "BridgeChoice" [color="black"];
  "BridgeChoice" -> "ServiceCheckChoice" [label="1. Re-run the service-level checks." color="gray40" fontcolor="gray40"];
  "BridgeChoice" -> "DependencyCheck" [label="2. Re-run the dependency checks." color="gray40" fontcolor="gray40"];
  "BridgeChoice" -> "ManualMitigationHandoff" [label="3. Prepare a manual handoff to the overnight or platform team." color="gray40" fontcolor="gray40"];
  "RecoverySummary" -> "RecoveryChoice" [color="black"];
  "RecoveryChoice" -> "RollbackComplete" [label="1. Close this as a rollback recovery." color="gray40" fontcolor="gray40"];
  "RecoveryChoice" -> "CapacityRecovered" [label="2. Close this as a capacity recovery." color="gray40" fontcolor="gray40"];
  "RecoveryChoice" -> "DependencyMitigated" [label="3. Close this as a dependency mitigation." color="gray40" fontcolor="gray40"];
  "RecoveryChoice" -> "FeatureFlagRecovered" [label="4. Close this as a feature-flag mitigation." color="gray40" fontcolor="gray40"];
  "FalseAlarmClosed" -> "End" [color="black"];
  "RollbackComplete" -> "End" [color="black"];
  "CapacityRecovered" -> "End" [color="black"];
  "DependencyMitigated" -> "End" [color="black"];
  "FeatureFlagRecovered" -> "End" [color="black"];
  "ManualMitigationHandoff" -> "End" [color="black"];
}
