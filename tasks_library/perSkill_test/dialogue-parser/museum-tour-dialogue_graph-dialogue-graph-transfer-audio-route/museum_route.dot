digraph MuseumRoute {
  rankdir=TB;
  node [fontname="Arial", fontsize="10"];
  edge [fontname="Arial", fontsize="8"];
  End [label="END", shape=doublecircle, style=filled, fillcolor="lightgray"];
  "Start" [label="Start\\nGuide: Welcome to the Harbor Museum. Your headset can branch between galleries whenever you choose.", shape=box, style="filled,rounded", fillcolor="white"];
  "OrientationHub" [label="OrientationHub", shape=diamond, style=filled, fillcolor="lightblue"];
  "FossilIntro" [label="FossilIntro\\nCurator: The fossil hall starts with a suspended mammoth and a floor map of vanished coastlines.", shape=box, style="filled,rounded", fillcolor="white"];
  "FossilChoice" [label="FossilChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "DinoNarration" [label="DinoNarration\\nCurator: Notice the healed fracture on the mammoth rib. It tells us the herd survived one brutal winter before the final thaw.", shape=box, style="filled,rounded", fillcolor="white"];
  "FossilDeepChoice" [label="FossilDeepChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "ClimatePanel" [label="ClimatePanel\\nCurator: Pollen trapped under the tusks matches a colder grassland than this city has seen in ten thousand years.", shape=box, style="filled,rounded", fillcolor="white"];
  "FieldStory" [label="FieldStory\\nGuide: The excavation crew nicknamed this skeleton Lantern because the ice around it glowed blue at sunrise.", shape=box, style="filled,rounded", fillcolor="white"];
  "AmberNarration" [label="AmberNarration\\nCurator: This amber drawer preserves insects, fern spores, and even one tiny feather barb caught mid-drift.", shape=box, style="filled,rounded", fillcolor="white"];
  "AmberChoice" [label="AmberChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "InsectZoom" [label="InsectZoom\\nGuide: The dragonfly's wing veins still align with species that now live only in tropical wetlands.", shape=box, style="filled,rounded", fillcolor="white"];
  "TradeRoute" [label="TradeRoute\\nGuide: Traders carried Baltic amber through ports that later fed the same shipping lanes highlighted in the maritime wing.", shape=box, style="filled,rounded", fillcolor="white"];
  "TimelineBridge" [label="TimelineBridge\\nGuide: The timeline wall links extinctions, migrations, and human toolmaking so visitors can jump between eras instead of walking chronologically.", shape=box, style="filled,rounded", fillcolor="white"];
  "MaritimeIntro" [label="MaritimeIntro\\nNarrator: The maritime wing mixes harbor storm recordings, navigation charts, and cargo recovered from a wreck near the old breakwater.", shape=box, style="filled,rounded", fillcolor="white"];
  "MaritimeChoice" [label="MaritimeChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "StormDeck" [label="StormDeck\\nGuide: The speakers above you replay a gale recorded by lighthouse staff during the winter blackout of 1926.", shape=box, style="filled,rounded", fillcolor="white"];
  "StormChoice" [label="StormChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "SurvivalNote" [label="SurvivalNote\\nGuide: Sailors tied themselves to the rail and counted bell strikes to measure distance when the stars vanished behind ice.", shape=box, style="filled,rounded", fillcolor="white"];
  "WhaleBridge" [label="WhaleBridge\\nNarrator: The migration overlay shows why the museum placed the whale gallery beside maritime history instead of natural science.", shape=box, style="filled,rounded", fillcolor="white"];
  "TradeMap" [label="TradeMap\\nArchivist: This map layers tea, amber, and copper routes so you can trace how one harbor connected exhibitions on opposite sides of the museum.", shape=box, style="filled,rounded", fillcolor="white"];
  "CaptainLog" [label="CaptainLog\\nArchivist: The captain's handwriting sharpens whenever the crew sailed close to reefs, as if caution tightened every line of ink.", shape=box, style="filled,rounded", fillcolor="white"];
  "CaptainChoice" [label="CaptainChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "MutinyRumor" [label="MutinyRumor\\nArchivist: One margin note claims the crew hid fresh water from the paying passengers, but no court ever proved it.", shape=box, style="filled,rounded", fillcolor="white"];
  "SailRepair" [label="SailRepair\\nConservator: The patched sail overhead was stitched with modern linen so visitors can still read the original wind tears.", shape=box, style="filled,rounded", fillcolor="white"];
  "LabIntro" [label="LabIntro\\nConservator: The restoration lab lets you follow pigment scans, frame repairs, and conservation interviews through the glass wall.", shape=box, style="filled,rounded", fillcolor="white"];
  "LabChoice" [label="LabChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "PigmentScan" [label="PigmentScan\\nConservator: Infrared images uncovered a hidden lighthouse sketch beneath the seascape now hanging beside the lab.", shape=box, style="filled,rounded", fillcolor="white"];
  "PigmentChoice" [label="PigmentChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "UVOverlay" [label="UVOverlay\\nConservator: Under ultraviolet light, later varnish glows green while the original brushwork stays matte and calm.", shape=box, style="filled,rounded", fillcolor="white"];
  "MineralOrigin" [label="MineralOrigin\\nGuide: The pigment minerals came through the same shipping network highlighted in the maritime trade map.", shape=box, style="filled,rounded", fillcolor="white"];
  "FrameRepair" [label="FrameRepair\\nConservator: The oak frame is clamped in three places so the warped corner can relax before the adhesive cures.", shape=box, style="filled,rounded", fillcolor="white"];
  "FrameChoice" [label="FrameChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "DemoBench" [label="DemoBench\\nGuide: A camera over the bench magnifies each brush stroke so even distant visitors can watch the filler settle into the cracks.", shape=box, style="filled,rounded", fillcolor="white"];
  "EthicsNote" [label="EthicsNote\\nConservator: We restore enough for stability and reading, but we do not repaint history into something neater than it ever was.", shape=box, style="filled,rounded", fillcolor="white"];
  "ConservatorIntro" [label="ConservatorIntro\\nConservator: Ask quickly; the solvent chamber restarts in three minutes and I need both hands free before then.", shape=box, style="filled,rounded", fillcolor="white"];
  "ConservatorChoice" [label="ConservatorChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "CareersAnswer" [label="CareersAnswer\\nConservator: Most conservators study chemistry, art history, and patient documentation long before they ever touch a public masterpiece.", shape=box, style="filled,rounded", fillcolor="white"];
  "BarrierAnswer" [label="BarrierAnswer\\nConservator: Rope barriers hold back vibration as much as people, which matters when a cracked panel reacts to every footstep.", shape=box, style="filled,rounded", fillcolor="white"];
  "AccessibilityIntro" [label="AccessibilityIntro\\nAccess Host: The accessibility desk can route you toward quieter spaces, family prompts, or a full transcript for every stop.", shape=box, style="filled,rounded", fillcolor="white"];
  "AccessibilityChoice" [label="AccessibilityChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "QuietRoute" [label="QuietRoute\\nAccess Host: The quiet route skips the storm speakers and sends you through the sculpture court before the busiest galleries fill up.", shape=box, style="filled,rounded", fillcolor="white"];
  "QuietChoice" [label="QuietChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "SculptureCourt" [label="SculptureCourt\\nNarrator: The sculpture court is hushed except for filtered air and the soft hum of the skylight motors overhead.", shape=box, style="filled,rounded", fillcolor="white"];
  "SculptureChoice" [label="SculptureChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "BronzeFocus" [label="BronzeFocus\\nGuide: The bronze surface records fingerprints from the artist's own thumbs, left visible on purpose beside the polished ridge.", shape=box, style="filled,rounded", fillcolor="white"];
  "TactileReplica" [label="TactileReplica\\nAccess Host: The replica station pairs touch-safe casts with short verbal cues so every form can be explored at your own pace.", shape=box, style="filled,rounded", fillcolor="white"];
  "MaritimeBypass" [label="MaritimeBypass\\nGuide: The bypass summary covers the shipwreck chart and captain's log without playing the storm recording.", shape=box, style="filled,rounded", fillcolor="white"];
  "FamilyRoute" [label="FamilyRoute\\nGuide: The family prompts turn each gallery into a short hunt for shapes, sounds, and clues hidden in the labels.", shape=box, style="filled,rounded", fillcolor="white"];
  "FamilyChoice" [label="FamilyChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "ShellChallenge" [label="ShellChallenge\\nGuide: Count how many shell spirals turn clockwise before you leave the maritime cabinets.", shape=box, style="filled,rounded", fillcolor="white"];
  "FootprintHunt" [label="FootprintHunt\\nGuide: The footprint trail begins in the fossil hall and loops past the mammoth map markers on the floor.", shape=box, style="filled,rounded", fillcolor="white"];
  "TranscriptSupport" [label="TranscriptSupport\\nAccess Host: I can send a QR transcript and explain the icon system printed on each route card.", shape=box, style="filled,rounded", fillcolor="white"];
  "SupportChoice" [label="SupportChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "TranscriptSent" [label="TranscriptSent\\nAccess Host: The transcript link is live for the next twenty-four hours and includes captions for every ambient audio segment.", shape=box, style="filled,rounded", fillcolor="white"];
  "IconGuide" [label="IconGuide\\nAccess Host: Blue icons mark optional detours, green icons mark family prompts, and silver icons mark quiet alternatives.", shape=box, style="filled,rounded", fillcolor="white"];
  "CrossWingChoice" [label="CrossWingChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "LoopGallery" [label="LoopGallery", shape=diamond, style=filled, fillcolor="lightblue"];
  "EchoReturn" [label="EchoReturn\\nNarrator: The guide pauses so you can choose a new direction without losing your place in the tour.", shape=box, style="filled,rounded", fillcolor="white"];
  "ReplayChoice" [label="ReplayChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "Start" -> "OrientationHub";
  "OrientationHub" -> "FossilIntro" [label="1. Begin with the fossil hall."];
  "OrientationHub" -> "MaritimeIntro" [label="2. Visit the maritime wing."];
  "OrientationHub" -> "LabIntro" [label="3. Enter the restoration lab."];
  "OrientationHub" -> "AccessibilityIntro" [label="4. Stop at the accessibility desk first."];
  "FossilIntro" -> "FossilChoice";
  "FossilChoice" -> "DinoNarration" [label="1. Focus on the mammoth skeleton."];
  "FossilChoice" -> "AmberNarration" [label="2. Open the amber specimen drawer."];
  "FossilChoice" -> "TimelineBridge" [label="3. Compare extinction timelines."];
  "DinoNarration" -> "FossilDeepChoice";
  "FossilDeepChoice" -> "ClimatePanel" [label="1. Hear the climate evidence."];
  "FossilDeepChoice" -> "FieldStory" [label="2. Hear the excavation field story."];
  "FossilDeepChoice" -> "OrientationHub" [label="3. Return to the museum map."];
  "ClimatePanel" -> "EchoReturn";
  "FieldStory" -> "EchoReturn";
  "AmberNarration" -> "AmberChoice";
  "AmberChoice" -> "InsectZoom" [label="1. Zoom in on the trapped dragonfly."];
  "AmberChoice" -> "TradeRoute" [label="2. Follow the amber trade route."];
  "AmberChoice" -> "FossilChoice" [label="3. Return to fossil choices."];
  "InsectZoom" -> "EchoReturn";
  "TradeRoute" -> "CrossWingChoice";
  "TimelineBridge" -> "LoopGallery";
  "MaritimeIntro" -> "MaritimeChoice";
  "MaritimeChoice" -> "StormDeck" [label="1. Play the storm deck audio."];
  "MaritimeChoice" -> "TradeMap" [label="2. Inspect the trade map."];
  "MaritimeChoice" -> "CaptainLog" [label="3. Read the captain's log."];
  "StormDeck" -> "StormChoice";
  "StormChoice" -> "SurvivalNote" [label="1. Learn the crew's survival tactics."];
  "StormChoice" -> "WhaleBridge" [label="2. Compare the storm route to whale migration paths."];
  "StormChoice" -> "OrientationHub" [label="3. Return to the museum map."];
  "SurvivalNote" -> "EchoReturn";
  "WhaleBridge" -> "EchoReturn";
  "TradeMap" -> "CrossWingChoice";
  "CaptainLog" -> "CaptainChoice";
  "CaptainChoice" -> "MutinyRumor" [label="1. Hear the mutiny rumor."];
  "CaptainChoice" -> "SailRepair" [label="2. Jump to the sail restoration note."];
  "CaptainChoice" -> "MaritimeChoice" [label="3. Return to maritime choices."];
  "MutinyRumor" -> "EchoReturn";
  "SailRepair" -> "LabIntro";
  "LabIntro" -> "LabChoice";
  "LabChoice" -> "PigmentScan" [label="1. Review the pigment scan station."];
  "LabChoice" -> "FrameRepair" [label="2. Watch the frame repair bench."];
  "LabChoice" -> "ConservatorIntro" [label="3. Ask the conservator a question."];
  "LabChoice" -> "OrientationHub" [label="4. Replay the main museum menu."];
  "PigmentScan" -> "PigmentChoice";
  "PigmentChoice" -> "UVOverlay" [label="1. Turn on the ultraviolet overlay."];
  "PigmentChoice" -> "MineralOrigin" [label="2. Trace where the minerals were imported from."];
  "PigmentChoice" -> "LabChoice" [label="3. Return to lab choices."];
  "UVOverlay" -> "EchoReturn";
  "MineralOrigin" -> "CrossWingChoice";
  "FrameRepair" -> "FrameChoice";
  "FrameChoice" -> "DemoBench" [label="1. Join the live repair demo."];
  "FrameChoice" -> "EthicsNote" [label="2. Hear the ethics note about restoration limits."];
  "FrameChoice" -> "LabChoice" [label="3. Return to lab choices."];
  "DemoBench" -> "EchoReturn";
  "EthicsNote" -> "AccessibilityIntro";
  "ConservatorIntro" -> "ConservatorChoice";
  "ConservatorChoice" -> "CareersAnswer" [label="1. How do people enter this field?"];
  "ConservatorChoice" -> "BarrierAnswer" [label="2. Why do rope barriers matter?"];
  "ConservatorChoice" -> "LabChoice" [label="3. Return to lab choices."];
  "CareersAnswer" -> "EchoReturn";
  "BarrierAnswer" -> "EchoReturn";
  "AccessibilityIntro" -> "AccessibilityChoice";
  "AccessibilityChoice" -> "QuietRoute" [label="1. [Quiet Route] Build a low-noise path."];
  "AccessibilityChoice" -> "FamilyRoute" [label="2. [Family] Start the scavenger prompts."];
  "AccessibilityChoice" -> "TranscriptSupport" [label="3. [Transcript] Send me the written guide."];
  "AccessibilityChoice" -> "OrientationHub" [label="4. Return to the museum map."];
  "QuietRoute" -> "QuietChoice";
  "QuietChoice" -> "SculptureCourt" [label="1. Start in the sculpture court."];
  "QuietChoice" -> "MaritimeBypass" [label="2. Use the maritime bypass summary."];
  "QuietChoice" -> "End" [label="3. End the tour here."];
  "SculptureCourt" -> "SculptureChoice";
  "SculptureChoice" -> "BronzeFocus" [label="1. Focus on the abstract bronze."];
  "SculptureChoice" -> "TactileReplica" [label="2. Visit the tactile replica station."];
  "SculptureChoice" -> "AccessibilityChoice" [label="3. Return to accessibility choices."];
  "BronzeFocus" -> "EchoReturn";
  "TactileReplica" -> "EchoReturn";
  "MaritimeBypass" -> "MaritimeIntro";
  "FamilyRoute" -> "FamilyChoice";
  "FamilyChoice" -> "ShellChallenge" [label="1. Hunt for spiral shells."];
  "FamilyChoice" -> "FootprintHunt" [label="2. Follow the fossil footprint trail."];
  "FamilyChoice" -> "AccessibilityChoice" [label="3. Return to accessibility choices."];
  "ShellChallenge" -> "EchoReturn";
  "FootprintHunt" -> "FossilIntro";
  "TranscriptSupport" -> "SupportChoice";
  "SupportChoice" -> "TranscriptSent" [label="1. Send the QR transcript now."];
  "SupportChoice" -> "IconGuide" [label="2. Explain the icon system."];
  "SupportChoice" -> "AccessibilityChoice" [label="3. Return to accessibility choices."];
  "TranscriptSent" -> "End";
  "IconGuide" -> "EchoReturn";
  "CrossWingChoice" -> "MaritimeIntro" [label="1. Continue into the maritime wing."];
  "CrossWingChoice" -> "LabIntro" [label="2. Continue into the restoration lab."];
  "CrossWingChoice" -> "End" [label="3. Wrap up the tour."];
  "LoopGallery" -> "MaritimeIntro" [label="1. Jump to the maritime wing next."];
  "LoopGallery" -> "LabIntro" [label="2. Jump to the restoration lab next."];
  "LoopGallery" -> "FossilChoice" [label="3. Return to fossil choices."];
  "EchoReturn" -> "ReplayChoice";
  "ReplayChoice" -> "OrientationHub" [label="1. Return to the museum map."];
  "ReplayChoice" -> "MaritimeIntro" [label="2. Head for the maritime wing."];
  "ReplayChoice" -> "LabIntro" [label="3. Head for the restoration lab."];
  "ReplayChoice" -> "End" [label="4. Conclude the tour."];
}
