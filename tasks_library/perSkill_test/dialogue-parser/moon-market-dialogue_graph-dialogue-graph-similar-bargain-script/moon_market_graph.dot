digraph DialogueGraph {
  rankdir=TB;
  splines=ortho;
  node [fontname="Arial", fontsize="10"];
  edge [fontname="Arial", fontsize="8"];
  "MoonMarketStart" [label="MoonMarketStart\\nNarrator: Silver lanterns sway over the moon market as Mira beckons you toward a crescent-shaped stall.", shape=box, style="filled,rounded", fillcolor="lightyellow"];
  "LanternGreeting" [label="LanternGreeting\\nMira: Looking for a tideglass lantern? This one still remembers the sea.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "PriceMenu" [label="PriceMenu", shape=diamond, style=filled, fillcolor="lightblue"];
  "FirstPrice" [label="FirstPrice\\nMira: Sixty silver crescents, with a fresh wick and moon-oil vial.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "AppraiseLantern" [label="AppraiseLantern\\nNarrator: The brass is honest work, but one rune ring has a hairline crack near the hinge.", shape=box, style="filled,rounded", fillcolor="lightyellow"];
  "AppraiseReply" [label="AppraiseReply\\nMira: Sharp eyes. That crack does not dim the light, but it does give us room to talk.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "BargainMenu" [label="BargainMenu", shape=diamond, style=filled, fillcolor="lightblue"];
  "LowOffer" [label="LowOffer\\nMira: Forty? I'd lose money before moonrise.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "LowOfferChoice" [label="LowOfferChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "BrokerLaughs" [label="BrokerLaughs\\nBroker: At forty, you may as well ask Mira to gift-wrap the moon.", shape=box, style="filled,rounded", fillcolor="lightgreen"];
  "EmbarrassedReset" [label="EmbarrassedReset\\nMira: Ignore him. If you want the lantern, make me a serious offer.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "LoreDiscount" [label="LoreDiscount\\nMira: Hm. Someone taught you the old marks. Fifty-two, and I'll stop pretending that crack is decorative.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "LoreChoice" [label="LoreChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "MidOffer" [label="MidOffer\\nMira: Fifty gets my attention, but not the lantern.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "MidOfferChoice" [label="MidOfferChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "FairOffer" [label="FairOffer\\nMira: Fifty-five is respectable. We are finally speaking the same language.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "FairOfferChoice" [label="FairOfferChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "CharmPitch" [label="CharmPitch\\nMira: Flattery buys you a smile, not a discount... unless you keep talking.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "CharmChoice" [label="CharmChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "CharmBackfire" [label="CharmBackfire\\nMira: Forty-eight and a grin? Bold. Try again when you bring better poetry.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "StoryPitch" [label="StoryPitch\\nMira: This lantern guided my sister through the eclipse floods. It shines steady when maps fail.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "StoryChoice" [label="StoryChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "BrokerTruth" [label="BrokerTruth\\nBroker: The story is true enough. The lantern works, but Mira is charging for the legend too.", shape=box, style="filled,rounded", fillcolor="lightgreen"];
  "TruthChoice" [label="TruthChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "TruthCounter" [label="TruthCounter\\nMira: Fifty-three, no hook, no extra oil. Final moonrise offer.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "FinalChoice" [label="FinalChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "AddOnTalk" [label="AddOnTalk\\nApprentice: We can include a carrying hook if the sale closes before the bell.", shape=box, style="filled,rounded", fillcolor="lightcyan"];
  "AddOnChoice" [label="AddOnChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "ReputationDeal" [label="ReputationDeal\\nMira: Bring me two customers tomorrow, and fifty will do tonight.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "ReputationChoice" [label="ReputationChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "ApprenticePitch" [label="ApprenticePitch\\nApprentice: Mistress, the cracked ring means we should move it before the damp gets worse.", shape=box, style="filled,rounded", fillcolor="lightcyan"];
  "ApprenticeChoice" [label="ApprenticeChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "RivalBluff" [label="RivalBluff\\nMira: Then the next stall is selling fog in a bottle. If your quote is real, prove it.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "BluffChoice" [label="BluffChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "BluffPressed" [label="BluffPressed\\nMira: Forty-five and no warranty, perhaps. I can do fifty-four if you stop performing for the crowd.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "GuardWarning" [label="GuardWarning\\nGuard: Keep the haggling civil. The bell is about to ring, and the lane stays open only for honest trade.", shape=box, style="filled,rounded", fillcolor="lightcoral"];
  "GuardChoice" [label="GuardChoice", shape=diamond, style=filled, fillcolor="lightblue"];
  "DealAccepted" [label="DealAccepted\\nMira: Done. The lantern, hook if promised, and fresh oil are yours.", shape=box, style="filled,rounded", fillcolor="peachpuff"];
  "WalkAway" [label="WalkAway\\nNarrator: You melt back into the moon market crowd, still weighing silver against starlight.", shape=box, style="filled,rounded", fillcolor="lightyellow"];
  "End" [label="END", shape=doublecircle, style=filled, fillcolor="lightgray"];
  "MoonMarketStart" -> "LanternGreeting" [color="black"];
  "LanternGreeting" -> "PriceMenu" [color="black"];
  "PriceMenu" -> "FirstPrice" [label="1. Ask the asking price.", color="gray40", fontcolor="gray40"];
  "PriceMenu" -> "AppraiseLantern" [label="2. [Appraise] Inspect the lantern frame and crystal seams.", color="darkblue", fontcolor="darkblue", style=bold];
  "PriceMenu" -> "RivalBluff" [label="3. [Bluff] Mention a cheaper offer from the next stall.", color="darkblue", fontcolor="darkblue", style=bold];
  "PriceMenu" -> "WalkAway" [label="4. Walk away and browse the market.", color="gray40", fontcolor="gray40"];
  "FirstPrice" -> "BargainMenu" [color="black"];
  "AppraiseLantern" -> "AppraiseReply" [color="black"];
  "AppraiseReply" -> "BargainMenu" [color="black"];
  "BargainMenu" -> "LowOffer" [label="1. Offer forty silver crescents.", color="gray40", fontcolor="gray40"];
  "BargainMenu" -> "FairOffer" [label="2. Offer fifty-five silver crescents.", color="gray40", fontcolor="gray40"];
  "BargainMenu" -> "CharmPitch" [label="3. [Charm] Praise Mira's craftsmanship before naming a price.", color="darkblue", fontcolor="darkblue", style=bold];
  "BargainMenu" -> "StoryPitch" [label="4. Ask why this lantern is worth more than the others.", color="gray40", fontcolor="gray40"];
  "LowOffer" -> "LowOfferChoice" [color="black"];
  "LowOfferChoice" -> "BrokerLaughs" [label="1. Hold firm at forty.", color="gray40", fontcolor="gray40"];
  "LowOfferChoice" -> "LoreDiscount" [label="2. [Moon Lore] Point out the cracked rune ring and old tideglass.", color="darkblue", fontcolor="darkblue", style=bold];
  "LowOfferChoice" -> "MidOffer" [label="3. Raise the offer to fifty.", color="gray40", fontcolor="gray40"];
  "LowOfferChoice" -> "PriceMenu" [label="4. Step back and restart the conversation.", color="gray40", fontcolor="gray40"];
  "BrokerLaughs" -> "EmbarrassedReset" [color="black"];
  "EmbarrassedReset" -> "BargainMenu" [color="black"];
  "LoreDiscount" -> "LoreChoice" [color="black"];
  "LoreChoice" -> "DealAccepted" [label="1. Accept fifty-two.", color="gray40", fontcolor="gray40"];
  "LoreChoice" -> "AddOnTalk" [label="2. Ask for a spare wick as well.", color="gray40", fontcolor="gray40"];
  "LoreChoice" -> "WalkAway" [label="3. Say you need another lap around the market.", color="gray40", fontcolor="gray40"];
  "MidOffer" -> "MidOfferChoice" [color="black"];
  "MidOfferChoice" -> "ReputationDeal" [label="1. Add a promise to recommend her stall.", color="gray40", fontcolor="gray40"];
  "MidOfferChoice" -> "ApprenticePitch" [label="2. [Signal] Nod to the apprentice to speak up for the lantern.", color="darkblue", fontcolor="darkblue", style=bold];
  "MidOfferChoice" -> "FairOffer" [label="3. Return to the higher offer.", color="gray40", fontcolor="gray40"];
  "FairOffer" -> "FairOfferChoice" [color="black"];
  "FairOfferChoice" -> "DealAccepted" [label="1. Take the deal.", color="gray40", fontcolor="gray40"];
  "FairOfferChoice" -> "AddOnTalk" [label="2. Ask for a carrying hook included.", color="gray40", fontcolor="gray40"];
  "FairOfferChoice" -> "ApprenticePitch" [label="3. [Signal] Invite the apprentice to sweeten the sale.", color="darkblue", fontcolor="darkblue", style=bold];
  "CharmPitch" -> "CharmChoice" [color="black"];
  "CharmChoice" -> "DealAccepted" [label="1. Offer fifty-two with a grin.", color="gray40", fontcolor="gray40"];
  "CharmChoice" -> "CharmBackfire" [label="2. Push your luck and ask for forty-eight.", color="gray40", fontcolor="gray40"];
  "CharmChoice" -> "AddOnTalk" [label="3. Ask for a travel hook instead of a lower price.", color="gray40", fontcolor="gray40"];
  "CharmBackfire" -> "BargainMenu" [color="black"];
  "StoryPitch" -> "StoryChoice" [color="black"];
  "StoryChoice" -> "DealAccepted" [label="1. Buy it for the quoted price.", color="gray40", fontcolor="gray40"];
  "StoryChoice" -> "BrokerTruth" [label="2. Ask the broker whether the story is true.", color="gray40", fontcolor="gray40"];
  "StoryChoice" -> "PriceMenu" [label="3. Circle the square and come back later.", color="gray40", fontcolor="gray40"];
  "BrokerTruth" -> "TruthChoice" [color="black"];
  "TruthChoice" -> "TruthCounter" [label="1. Use that admission to counter at fifty-three.", color="gray40", fontcolor="gray40"];
  "TruthChoice" -> "WalkAway" [label="2. Thank them both and leave.", color="gray40", fontcolor="gray40"];
  "TruthChoice" -> "DealAccepted" [label="3. Decide the story is worth the full price.", color="gray40", fontcolor="gray40"];
  "TruthCounter" -> "FinalChoice" [color="black"];
  "FinalChoice" -> "DealAccepted" [label="1. Accept the final offer.", color="gray40", fontcolor="gray40"];
  "FinalChoice" -> "WalkAway" [label="2. Refuse and leave.", color="gray40", fontcolor="gray40"];
  "AddOnTalk" -> "AddOnChoice" [color="black"];
  "AddOnChoice" -> "DealAccepted" [label="1. Agree to the current price with the hook.", color="gray40", fontcolor="gray40"];
  "AddOnChoice" -> "GuardWarning" [label="2. Try to shave off two more silver.", color="gray40", fontcolor="gray40"];
  "AddOnChoice" -> "WalkAway" [label="3. Decide against the purchase.", color="gray40", fontcolor="gray40"];
  "ReputationDeal" -> "ReputationChoice" [color="black"];
  "ReputationChoice" -> "DealAccepted" [label="1. Accept the promise deal.", color="gray40", fontcolor="gray40"];
  "ReputationChoice" -> "BargainMenu" [label="2. Decide you cannot promise that.", color="gray40", fontcolor="gray40"];
  "ApprenticePitch" -> "ApprenticeChoice" [color="black"];
  "ApprenticeChoice" -> "FinalChoice" [label="1. Offer fifty-one silver now.", color="gray40", fontcolor="gray40"];
  "ApprenticeChoice" -> "BargainMenu" [label="2. Thank the apprentice and return to the main negotiation.", color="gray40", fontcolor="gray40"];
  "RivalBluff" -> "BluffChoice" [color="black"];
  "BluffChoice" -> "BluffPressed" [label="1. [Bluff] Insist the other merchant offered forty-five.", color="darkblue", fontcolor="darkblue", style=bold];
  "BluffChoice" -> "BargainMenu" [label="2. Admit you exaggerated.", color="gray40", fontcolor="gray40"];
  "BluffChoice" -> "WalkAway" [label="3. Leave to compare stalls.", color="gray40", fontcolor="gray40"];
  "BluffPressed" -> "FinalChoice" [color="black"];
  "GuardWarning" -> "GuardChoice" [color="black"];
  "GuardChoice" -> "DealAccepted" [label="1. Apologize and accept the standing offer.", color="gray40", fontcolor="gray40"];
  "GuardChoice" -> "WalkAway" [label="2. Take the hint and leave.", color="gray40", fontcolor="gray40"];
  "DealAccepted" -> "End" [color="black"];
  "WalkAway" -> "End" [color="black"];
}
