{
  "summary_file": "/root/transfer3_namespace_guardrail_report.md",
  "summary_title": "Transfer - Sweep Jakarta Imports Without Touching JDK APIs",
  "summary_points": [
    "Migrated only Java EE imports into the Jakarta namespace.",
